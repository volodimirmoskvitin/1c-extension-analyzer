
#Область ПрограммныйИнтерфейс

// Функция регистрации обработки в подсистеме БСП "Дополнительные отчеты и обработки"
//
// Возвращаемое значение:
//  Структура - параметры регистрации обработки
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Версия", "1.0.0.1");
	ПараметрыРегистрации.Вставить("Назначение", Новый Массив);
	ПараметрыРегистрации.Вставить("Наименование", "Анализ конфликтов расширений конфигурации");
	ПараметрыРегистрации.Вставить("Информация", "Аудит коллизий и конфликтов между расширениями конфигурации (&Вместо, &ИзменениеИКонтроль, события, метаданные)");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	СтрокаКоманды = Команды.Добавить();
	СтрокаКоманды.Идентификатор = "ОткрытьФорму";
	СтрокаКоманды.Использование = "ОткрытиеФормы";
	СтрокаКоманды.Представление = "Анализ расширений";
	СтрокаКоманды.ПоказыватьОповещение = Ложь;
	СтрокаКоманды.Модификатор = "";
	
	ПараметрыРегистрации.Вставить("Команды", Команды);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

#КонецОбласти