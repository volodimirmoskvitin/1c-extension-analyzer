
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	УдалятьВременныеФайлы = Истина;
	НастроитьУсловноеОформлениеФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбеспечитьКаталогВыгрузкиНаКлиенте();
	ОбновитьДоступностьУдаленияВременныхФайлов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если УдалятьВременныеФайлы И ЭтоСтандартныйКаталогВыгрузки(КаталогВыгрузки) Тогда
		ОчиститьВременнуюВыгрузкуXMLНаКлиенте();
	КонецЕсли;
	
	// Безопасное удаление временных файлов скриптов и меток
	Если ЗначениеЗаполнено(ФайлЛогаФон) Тогда
		Попытка
			УдалитьФайлы(ФайлЛогаФон + ".done");
			УдалитьФайлы(ФайлЛогаФон + ".cmd");
			УдалитьФайлы(ФайлЛогаФон + ".vbs");
			УдалитьФайлы(ФайлЛогаФон);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КаталогВыгрузкиПриИзменении(Элемент)
	
	ОбновитьДоступностьУдаленияВременныхФайлов();
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите каталог с выгруженными исходниками расширений";
	Если ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		Диалог.Каталог = КаталогВыгрузки;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораКаталогаВыгрузки", ЭтотОбъект);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоКонфликтыПриИзменении(Элемент)
	
	ПрименитьФильтрДереваОбъектов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыТаблицаКонфликтов

&НаКлиенте
Процедура ТаблицаКонфликтовПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ТекущееОписаниеКонфликта = "";
	Иначе
		ТекущееОписаниеКонфликта = СформироватьПодробноеОписаниеКонфликта(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКонфликтовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьПредупреждение(, СформироватьПодробноеОписаниеКонфликта(ТекущиеДанные));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьАнализОбработка(Команда)
	
	ОбеспечитьКаталогВыгрузкиНаКлиенте();
	
	// Если каталог исходников на клиенте пуст или отсутствует, запускаем фоновую выгрузку
	КаталогИмеетФайлы = ПроверитьНаличиеВыгрузкиНаКлиенте(КаталогВыгрузки);
	Если Не КаталогИмеетФайлы Тогда
		КоличествоРасширенийВБазе = ПолучитьКоличествоРасширенийНаСервере();
		Если КоличествоРасширенийВБазе = 0 Тогда
			ПоказатьПредупреждение(, "В текущей информационной базе нет подключенных расширений конфигурации." + Символы.ПС
				+ "Для анализа внешних исходников укажите каталог с выгруженными XML-файлами расширений в поле ""Каталог выгрузки"".");
			Возврат;
		КонецЕсли;
		
		ВыгрузитьИсходникиКонфигураторомОбработка(Неопределено);
		Возврат;
	КонецЕсли;
	
	ЗапуститьАнализСПередачейНаСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчетОбработка(Команда)
	
	Если ТаблицаКонфликтов.Количество() = 0 И ТаблицаРасширений.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выполните анализ расширений.");
		Возврат;
	КонецЕсли;
	
	ТабДок = СформироватьТабличныйДокументНаСервере();
	ТабДок.Показать("Анализ расширений конфигурации");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьИсходникиКонфигураторомОбработка(Команда)
	
	ОбеспечитьКаталогВыгрузкиНаКлиенте();
	ЗапуститьФоновуюВыгрузку();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеВыбораКаталогаВыгрузки(ВыбранныеКаталоги, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеКаталоги <> Неопределено И ВыбранныеКаталоги.Количество() > 0 Тогда
		КаталогВыгрузки = ВыбранныеКаталоги[0];
		ОбновитьДоступностьУдаленияВременныхФайлов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТекущееОписаниеКонфликта()
	
	Если ТаблицаКонфликтов.Количество() > 0 Тогда
		Элементы.ТаблицаКонфликтов.ТекущаяСтрока = ТаблицаКонфликтов[0].ПолучитьИдентификатор();
		ТекущееОписаниеКонфликта = СформироватьПодробноеОписаниеКонфликта(ТаблицаКонфликтов[0]);
	Иначе
		ТекущееОписаниеКонфликта = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьПодробноеОписаниеКонфликта(СтрокаКонфликта)
	
	Текст = "Конфликт: [%1] %2
		|Объект: %3
		|Расширения: %4
		|--------------------------------------------------------------------------------
		|%5";
	
	Текст = СтрШаблон(Текст,
		СтрокаКонфликта.Критичность,
		СтрокаКонфликта.ВидКонфликта,
		СтрокаКонфликта.ОбъектМетаданных + ?(ЗначениеЗаполнено(СтрокаКонфликта.Элемент), " -> " + СтрокаКонфликта.Элемент, ""),
		СтрокаКонфликта.Расширения,
		СтрокаКонфликта.Описание);
		
	Возврат Текст;
	
КонецФункции

&НаКлиенте
Процедура ОбеспечитьКаталогВыгрузкиНаКлиенте()
	
	Если Не ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		КаталогВыгрузки = ПолучитьСтандартныйКаталогВыгрузки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьФоновуюВыгрузку()
	
	ОбеспечитьКаталогВыгрузкиНаКлиенте();
	
	ПараметрыЗапуска = ПодготовитьКомандуВыгрузкиНаКлиенте(КаталогВыгрузки, ПользовательИБ, ПарольИБ);
	
	Если Не ПараметрыЗапуска.Успешно Тогда
		ПоказатьПредупреждение(, ПараметрыЗапуска.Ошибка);
		Возврат;
	КонецЕсли;
	
	ФайлЛогаФон = ПараметрыЗапуска.ФайлЛога;
	ШагИндикатора = 0;
	ВремяНачалаВыгрузки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗатраченоСекундВыгрузка = 0;
	ЗатраченоСекундАнализ = 0;
	
	Попытка
		ЗапуститьПриложение(ПараметрыЗапуска.КоманднаяСтрока);
	Исключение
		ПоказатьПредупреждение(, "Не удалось запустить фоновую выгрузку: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Элементы.КомандаВыполнитьАнализ.Доступность = Ложь;
	
	Элементы.НадписьИндикаторВыгрузки.Видимость = Истина;
	Элементы.НадписьИндикаторВыгрузки.Заголовок = "Выгрузка расширений в фоне... Выгружено XML-файлов: 0 | Время: 0 сек.";
	Состояние("Выполняется фоновая выгрузка расширений...");
	
	ПодключитьОбработчикОжидания("ПроверитьЗавершениеФоновойВыгрузки", 1);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершениеФоновойВыгрузки()
	
	СостояниеВыгрузки = ПроверитьСтатусВыгрузкиНаКлиенте(ФайлЛогаФон, КаталогВыгрузки);
	
	Если Не СостояниеВыгрузки.Завершено Тогда
		ШагИндикатора = ШагИндикатора + 1;
		
		ТекстПрогресса = "Выгрузка расширений в фоне... Выгружено XML-файлов: " 
			+ Строка(СостояниеВыгрузки.ВыгруженоФайлов) + " | Время: " + Строка(ШагИндикатора) + " сек.";
		Элементы.НадписьИндикаторВыгрузки.Заголовок = ТекстПрогресса;
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПроверитьЗавершениеФоновойВыгрузки");
	
	Элементы.КомандаВыполнитьАнализ.Доступность = Истина;
	
	Если СостояниеВыгрузки.Успешно Тогда
		Если ЗначениеЗаполнено(ВремяНачалаВыгрузки) И ВремяНачалаВыгрузки > 0 Тогда
			ЗатраченоСекундВыгрузка = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаВыгрузки) / 1000, 1);
		Иначе
			ЗатраченоСекундВыгрузка = ШагИндикатора;
		КонецЕсли;
		
		Элементы.НадписьИндикаторВыгрузки.Заголовок = "Выгрузка завершена (" + Строка(ЗатраченоСекундВыгрузка) + " сек.)! Выполняется разбор XML и BSL модулей расширений...";
		Состояние("Выполняется анализ выгруженных расширений...");
		
		// Запускаем анализ выгруженных исходников
		ЗапуститьАнализСПередачейНаСервер();
	Иначе
		Элементы.НадписьИндикаторВыгрузки.Заголовок = "Ошибка при фоновой выгрузке расширений (код: " + Строка(СостояниеВыгрузки.КодВозврата) + ")";
		
		СообщениеОбОшибке = "Ошибка при выгрузке расширений Конфигуратором (код возврата: " 
			+ Строка(СостояниеВыгрузки.КодВозврата) + ")." + Символы.ПС;
			
		Если ЗначениеЗаполнено(СостояниеВыгрузки.ТекстЛога) Тогда
			СообщениеОбОшибке = СообщениеОбОшибке + Символы.ПС + "Лог Конфигуратора:" + Символы.ПС + СостояниеВыгрузки.ТекстЛога;
		Иначе
			СообщениеОбОшибке = СообщениеОбОшибке + Символы.ПС 
				+ "Проверьте корректность введённого логина/пароля и отсутствие открытого Конфигуратора.";
		КонецЕсли;
		
		ПоказатьПредупреждение(, СообщениеОбОшибке);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьАнализСПередачейНаСервер()
	
	ОбеспечитьКаталогВыгрузкиНаКлиенте();
	
	ВремяНачалаАнализа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Элементы.НадписьИндикаторВыгрузки.Видимость = Истина;
	Элементы.НадписьИндикаторВыгрузки.Заголовок = "Выполняется разбор XML и BSL модулей расширений...";
	Состояние("Выполняется анализ расширений...");
	
	МассивЭлементовВыгрузки = Новый Массив;
	ИндексЭлементов = Новый Соответствие;
	
	Если ПроверитьНаличиеВыгрузкиНаКлиенте(КаталогВыгрузки) Тогда
		СоответствиеАктивныхРасширений = ПолучитьСоответствиеАктивныхРасширенийНаСервере();
		СканироватьВыгруженныеИсходники(КаталогВыгрузки, СоответствиеАктивныхРасширений, МассивЭлементовВыгрузки, ИндексЭлементов);
	КонецЕсли;
	
	ВыполнитьАнализНаСервере(МассивЭлементовВыгрузки);
	ОбновитьТекущееОписаниеКонфликта();
	
	Если УдалятьВременныеФайлы И ЭтоСтандартныйКаталогВыгрузки(КаталогВыгрузки) Тогда
		ОчиститьВременнуюВыгрузкуXMLНаКлиенте();
	КонецЕсли;
	
	ЗатраченоСекундАнализ = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаАнализа) / 1000, 1);
	
	Если ЗначениеЗаполнено(ЗатраченоСекундВыгрузка) И ЗатраченоСекундВыгрузка > 0 Тогда
		ТекстИтога = "Выгрузка и анализ расширений успешно завершены (время выгрузки XML: " 
			+ Строка(ЗатраченоСекундВыгрузка) + " сек., время анализа: " + Строка(ЗатраченоСекундАнализ) + " сек.)";
	Иначе
		ТекстИтога = "Анализ расширений успешно завершен (время анализа: " + Строка(ЗатраченоСекундАнализ) + " сек.)";
	КонецЕсли;
	
	Элементы.НадписьИндикаторВыгрузки.Заголовок = ТекстИтога;
	Состояние(ТекстИтога);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСоответствиеАктивныхРасширенийНаСервере()
	
	СоответствиеАктивныхРасширений = Новый Соответствие;
	МассивРасширений = РасширенияКонфигурации.Получить();
	ПорядковыйНомер = 0;
	Для Каждого Расширение Из МассивРасширений Цикл
		ПорядковыйНомер = ПорядковыйНомер + 1;
		Если Расширение.Активно Тогда
			СоответствиеАктивныхРасширений.Вставить(ВРег(Расширение.Имя), ПорядковыйНомер);
		КонецЕсли;
	КонецЦикла;
	Возврат СоответствиеАктивныхРасширений;
	
КонецФункции

&НаКлиенте
Функция ПроверитьСтатусВыгрузкиНаКлиенте(ПутьКФайлуЛога, КаталогДляПроверки = "")
	
	Результат = Новый Структура;
	Результат.Вставить("Завершено", Ложь);
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("КодВозврата", -1);
	Результат.Вставить("ТекстЛога", "");
	Результат.Вставить("ВыгруженоФайлов", 0);
	
	ФайлМетки = Новый Файл(ПутьКФайлуЛога + ".done");
	Если Не ФайлМетки.Существует() Тогда
		Попытка
			Если ЗначениеЗаполнено(КаталогДляПроверки) Тогда
				НайденныеФайлы = НайтиФайлы(КаталогДляПроверки, "*.xml", Истина);
				Результат.ВыгруженоФайлов = НайденныеФайлы.Количество();
			КонецЕсли;
		Исключение
		КонецПопытки;
		Возврат Результат; // Еще идет выгрузка
	КонецЕсли;
	
	// Процесс завершился
	КодВозврата = 0;
	Попытка
		ЧтениеМетки = Новый ЧтениеТекста(ПутьКФайлуЛога + ".done", КодировкаТекста.ANSI);
		СтрКода = СокрЛП(ЧтениеМетки.Прочитать());
		ЧтениеМетки.Закрыть();
		КодВозврата = Число(СтрКода);
	Исключение
		КодВозврата = 0;
	КонецПопытки;
	
	// Читаем лог Конфигуратора
	ТекстЛога = "";
	Попытка
		ЧтениеЛога = Новый ЧтениеТекста(ПутьКФайлуЛога, КодировкаТекста.ANSI);
		ТекстЛога = ЧтениеЛога.Прочитать();
		ЧтениеЛога.Закрыть();
	Исключение
	КонецПопытки;
	
	// Удаляем временные метки, скрипты и лог
	Попытка
		УдалитьФайлы(ПутьКФайлуЛога + ".done");
		УдалитьФайлы(ПутьКФайлуЛога + ".cmd");
		УдалитьФайлы(ПутьКФайлуЛога + ".vbs");
		УдалитьФайлы(ПутьКФайлуЛога);
	Исключение
	КонецПопытки;
	
	Результат.Завершено = Истина;
	Результат.КодВозврата = КодВозврата;
	Результат.Успешно = (КодВозврата = 0);
	Результат.ТекстЛога = ТекстЛога;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКлючПодключенияИБНаСервере()
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	
	// Проверка веб-соединения
	Если СтрНайти(ВРег(СтрокаСоединения), "WS=") > 0 Или СтрНайти(ВРег(СтрокаСоединения), "HTTP=") > 0 Тогда
		Возврат "ВЕБ_СОЕДИНЕНИЕ";
	КонецЕсли;
	
	// Разбираем строку соединения типа File="D:\Base"; или Srvr="Server";Ref="Base";
	// И формируем прямой ключ /F или /S без вложенных кавычек, чтобы не открывалось окно выбора базы
	Части = СтрРазделить(СтрокаСоединения, ";");
	ПутьФайловойБазы = "";
	СерверИБ = "";
	ИмяБазыНаСервере = "";
	
	Для Каждого Часть Из Части Цикл
		ЧастьСокр = СокрЛП(Часть);
		Если ПустаяСтрока(ЧастьСокр) Тогда
			Продолжить;
		КонецЕсли;
		
		ПозРавно = СтрНайти(ЧастьСокр, "=");
		Если ПозРавно > 0 Тогда
			Ключ = ВРег(СокрЛП(Лев(ЧастьСокр, ПозРавно - 1)));
			Значение = СокрЛП(Сред(ЧастьСокр, ПозРавно + 1));
			
			// Снимаем обрамляющие кавычки
			Если СтрДлина(Значение) >= 2 И Лев(Значение, 1) = """" И Прав(Значение, 1) = """" Тогда
				Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
			КонецЕсли;
			
			Если Ключ = "FILE" Тогда
				ПутьФайловойБазы = Значение;
			ИначеЕсли Ключ = "SRVR" Тогда
				СерверИБ = Значение;
			ИначеЕсли Ключ = "REF" Тогда
				ИмяБазыНаСервере = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПутьФайловойБазы) Тогда
		Возврат "/F """ + ПутьФайловойБазы + """";
	ИначеЕсли ЗначениеЗаполнено(СерверИБ) И ЗначениеЗаполнено(ИмяБазыНаСервере) Тогда
		Возврат "/S """ + СерверИБ + "\" + ИмяБазыНаСервере + """";
	Иначе
		// Экранируем кавычки для /IBConnectionString
		ЭкранированнаяСтрока = СтрЗаменить(СтрокаСоединения, """", """""");
		Возврат "/IBConnectionString """ + ЭкранированнаяСтрока + """";
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьКомандуВыгрузкиНаКлиенте(ЛокальныйКаталогВыгрузки, Пользователь, Пароль)
	
	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("КоманднаяСтрока", "");
	Результат.Вставить("ФайлЛога", "");
	Результат.Вставить("Ошибка", "");
	
#Если ВебКлиент Тогда
	Результат.Ошибка = "Автоматическая выгрузка через конфигуратор недоступна в веб-клиенте.
		|Пожалуйста, используйте тонкий или толстый клиент, либо укажите готовый каталог с исходниками расширений в поле ""Каталог выгрузки"".";
	Возврат Результат;
#КонецЕсли

	СистемнаяИнфо = Новый СистемнаяИнформация;
	Если СистемнаяИнфо.ТипПлатформы <> ТипПлатформы.Windows_x86 И СистемнаяИнфо.ТипПлатформы <> ТипПлатформы.Windows_x86_64 Тогда
		Результат.Ошибка = "Автоматический запуск выгрузки Конфигуратора через wscript/cmd поддерживается только в ОС Windows.
			|В среде Linux/macOS укажите каталог с предварительно выгруженными исходниками расширений в поле ""Каталог выгрузки"".";
		Возврат Результат;
	КонецЕсли;

	// Подготавливаем каталог выгрузки на клиенте
	Попытка
		ПапкаВыгрузки = Новый Файл(ЛокальныйКаталогВыгрузки);
		Если ПапкаВыгрузки.Существует() Тогда
			Если ЭтоСтандартныйКаталогВыгрузки(ЛокальныйКаталогВыгрузки) Тогда
				УдалитьФайлы(ЛокальныйКаталогВыгрузки);
				СоздатьКаталог(ЛокальныйКаталогВыгрузки);
			КонецЕсли;
		Иначе
			СоздатьКаталог(ЛокальныйКаталогВыгрузки);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	// Определяем путь к исполняемому файлу 1cv8.exe текущей версии платформы на клиенте
	КаталогПрограммыКлиент = КаталогПрограммы();
	ИмяФайла1С = КаталогПрограммыКлиент + "1cv8.exe";
	
	ФайлПлатформы = Новый Файл(ИмяФайла1С);
	Если Не ФайлПлатформы.Существует() Тогда
		// Попытка автопоиска 1cv8.exe в стандартных путях, если на клиенте запущен тонкий клиент (1cv8c.exe)
		МассивКаталогов = Новый Массив;
		МассивКаталогов.Добавить("C:\Program Files\1cv8\");
		МассивКаталогов.Добавить("C:\Program Files (x86)\1cv8\");
		
		НайденExe = "";
		Для Каждого БазовыйКаталог Из МассивКаталогов Цикл
			Папка1С = Новый Файл(БазовыйКаталог);
			Если Папка1С.Существует() Тогда
				НайденныеФайлы = НайтиФайлы(БазовыйКаталог, "1cv8.exe", Истина);
				Если НайденныеФайлы.Количество() > 0 Тогда
					НайденExe = НайденныеФайлы[НайденныеФайлы.Количество() - 1].ПолноеИмя;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(НайденExe) Тогда
			ФайлПроверки = Новый Файл(НайденExe);
			Если ФайлПроверки.Существует() Тогда
				ИмяФайла1С = НайденExe;
			Иначе
				НайденExe = "";
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НайденExe) Тогда
			ТекстОшибки = "Исполняемый файл Конфигуратора (1cv8.exe) не найден в каталоге клиента: %1
				|Возможно, на данном ПК установлен только Тонкий клиент 1С.
				|Укажите каталог с готовыми исходниками расширений в поле ""Каталог выгрузки"".";
			Результат.Ошибка = СтрШаблон(ТекстОшибки, КаталогПрограммыКлиент);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрБазы = ПолучитьКлючПодключенияИБНаСервере();
	Если ПараметрБазы = "ВЕБ_СОЕДИНЕНИЕ" Тогда
		Результат.Ошибка = "Информационная база подключена через веб-сервер. Конфигуратор 1С не поддерживает выгрузку по веб-ссылке.
			|Подключитесь к базе напрямую (через сервер 1С или файловый каталог) либо укажите готовый каталог с исходниками в поле ""Каталог выгрузки"".";
		Возврат Результат;
	КонецЕсли;
	
	// Файл лога выгрузки и скрипты создаем в локальном TEMP клиента
	ФайлЛога = КаталогВременныхФайлов() + "dump_ext_" + Строка(Новый УникальныйИдентификатор()) + ".log";
	ФайлМетки = ФайлЛога + ".done";
	ФайлСкрипта = ФайлЛога + ".cmd";
	
	// Команда вызова конфигуратора
	Команда1С = СтрШаблон("""%1"" DESIGNER %2", ИмяФайла1С, ПараметрБазы);
	
	Если ЗначениеЗаполнено(Пользователь) Тогда
		Команда1С = СтрШаблон("%1 /N ""%2""", Команда1С, Пользователь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Пароль) Тогда
		Команда1С = СтрШаблон("%1 /P ""%2""", Команда1С, Пароль);
	КонецЕсли;
	
	Команда1С = СтрШаблон("%1 /DisableStartupDialogs /DisableStartupMessages /DumpConfigToFiles ""%2"" -AllExtensions /Out ""%3""", Команда1С, ЛокальныйКаталогВыгрузки, ФайлЛога);
	
	ТекстСкрипта = "@echo off
		|chcp 65001 >nul
		|%1
		|echo %%ERRORLEVEL%% > ""%2""
		|exit";
	ТекстСкрипта = СтрШаблон(ТекстСкрипта, Команда1С, ФайлМетки);
	
	// CMD-скрипт в кодировке UTF-8 без BOM
	ДвоичныеДанныеСкрипта = ПолучитьДвоичныеДанныеИзСтроки(ТекстСкрипта, КодировкаТекста.UTF8, Ложь);
	ДвоичныеДанныеСкрипта.Записать(ФайлСкрипта);
	
	// Создаем VBS-обертку с режимом окна 0 (vbHide), чтобы окно cmd.exe не появлялось на экране
	ФайлVBS = ФайлЛога + ".vbs";
	ТекстVBS = СтрШаблон("CreateObject(""WScript.Shell"").Run """"""%1"""""", 0, False", ФайлСкрипта);
	ЗаписьVBS = Новый ЗаписьТекста(ФайлVBS, КодировкаТекста.ANSI);
	ЗаписьVBS.Записать(ТекстVBS);
	ЗаписьVBS.Закрыть();
	
	КоманднаяСтрока = СтрШаблон("wscript.exe //B //Nologo ""%1""", ФайлVBS);
	
	Результат.Успешно = Истина;
	Результат.КоманднаяСтрока = КоманднаяСтрока;
	Результат.ФайлЛога = ФайлЛога;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтандартныйКаталогВыгрузки()
	
	Темп = КаталогВременныхФайлов();
	Если Прав(Темп, 1) = "\" Или Прав(Темп, 1) = "/" Тогда
		Возврат Темп + "ExtDump_XML";
	Иначе
		Возврат Темп + "\ExtDump_XML";
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКоличествоРасширенийНаСервере()
	
	Возврат РасширенияКонфигурации.Получить().Количество();
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьПутьКаталога(Путь)
	
	Стр = СокрЛП(Путь);
	Стр = СтрЗаменить(Стр, "/", "\");
	Пока СтрДлина(Стр) > 0 И Прав(Стр, 1) = "\" Цикл
		Стр = Лев(Стр, СтрДлина(Стр) - 1);
	КонецЦикла;
	Возврат ВРег(Стр);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСтандартныйКаталогВыгрузки(КаталогПроверки)
	
	Если Не ЗначениеЗаполнено(КаталогПроверки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	НормПроверки = НормализоватьПутьКаталога(КаталогПроверки);
	НормСтандарт = НормализоватьПутьКаталога(ПолучитьСтандартныйКаталогВыгрузки());
	
	Возврат (НормПроверки = НормСтандарт);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоКаталогВременныхФайлов(КаталогПроверки)
	
	Если Не ЗначениеЗаполнено(КаталогПроверки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат (НормализоватьПутьКаталога(КаталогПроверки) = НормализоватьПутьКаталога(КаталогВременныхФайлов()));
	
КонецФункции

&НаКлиенте
Процедура ОбновитьДоступностьУдаленияВременныхФайлов()
	
	СтандартныйКаталог = ЭтоСтандартныйКаталогВыгрузки(КаталогВыгрузки);
	
	Если Не СтандартныйКаталог Тогда
		УдалятьВременныеФайлы = Ложь;
		Элементы.УдалятьВременныеФайлы.Доступность = Ложь;
	Иначе
		Если Не Элементы.УдалятьВременныеФайлы.Доступность Тогда
			УдалятьВременныеФайлы = Истина;
		КонецЕсли;
		Элементы.УдалятьВременныеФайлы.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСведенияОКонфигурацииXML(ПутьКConfigurationXML)
	
	Результат = Новый Структура("ЭтоРасширение, Имя", Ложь, "");
	
	Попытка
		ЧтениеXML = Новый ЧтениеТекста(ПутьКConfigurationXML, КодировкаТекста.UTF8);
		Текст = ЧтениеXML.Прочитать();
		ЧтениеXML.Закрыть();
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	// Конфигурация является расширением (CFE), если содержит маркер назначения расширения
	Результат.ЭтоРасширение = (СтрНайти(Текст, "<ConfigurationExtensionPurpose>") > 0
		Или СтрНайти(Текст, "<НазначениеРасширенияКонфигурации>") > 0);
	
	// Извлекаем имя конфигурации/расширения
	ПозИмени = СтрНайти(Текст, "<Name>");
	ДлинаТега = 6;
	Если ПозИмени = 0 Тогда
		ПозИмени = СтрНайти(Текст, "<Имя>");
		ДлинаТега = 5;
	КонецЕсли;
	
	Если ПозИмени > 0 Тогда
		ПозКонца = ?(ДлинаТега = 6, СтрНайти(Текст, "</Name>", , ПозИмени), СтрНайти(Текст, "</Имя>", , ПозИмени));
		Если ПозКонца > ПозИмени Тогда
			Результат.Имя = СокрЛП(Сред(Текст, ПозИмени + ДлинаТега, ПозКонца - ПозИмени - ДлинаТега));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОчиститьВременнуюВыгрузкуXMLНаКлиенте()
	
	// Безопасность: очищаем строго стандартный каталог Temp + ExtDump_XML
	Если Не ЭтоСтандартныйКаталогВыгрузки(КаталогВыгрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтандартныйКаталог = ПолучитьСтандартныйКаталогВыгрузки();
	Папка = Новый Файл(СтандартныйКаталог);
	Если Не Папка.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		УдалитьФайлы(СтандартныйКаталог);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ПроверитьНаличиеВыгрузкиНаКлиенте(ЛокальныйКаталогВыгрузки)
	
	Если Не ЗначениеЗаполнено(ЛокальныйКаталогВыгрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Папка = Новый Файл(ЛокальныйКаталогВыгрузки);
	Если Не Папка.Существует() Или Не Папка.ЭтоКаталог() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Системный каталог временных файлов никогда не считается готовой выгрузкой
	Если ЭтоКаталогВременныхФайлов(ЛокальныйКаталогВыгрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Проверяем наличие Configuration.xml в корне либо в непосредственных подкаталогах
	МассивФайлов = Новый Массив;
	КонфВКорне = НайтиФайлы(ЛокальныйКаталогВыгрузки, "Configuration.xml", Ложь);
	Для Каждого Ф Из КонфВКорне Цикл
		МассивФайлов.Добавить(Ф);
	КонецЦикла;
	
	Подпапки = НайтиФайлы(ЛокальныйКаталогВыгрузки, "*", Ложь);
	Для Каждого Подпапка Из Подпапки Цикл
		Если Подпапка.ЭтоКаталог() Тогда
			КонфВПодпапке = НайтиФайлы(Подпапка.ПолноеИмя, "Configuration.xml", Ложь);
			Для Каждого Ф Из КонфВПодпапке Цикл
				МассивФайлов.Добавить(Ф);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Ф Из МассивФайлов Цикл
		Сведения = ПолучитьСведенияОКонфигурацииXML(Ф.ПолноеИмя);
		Если Сведения.ЭтоРасширение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ПрименитьФильтрДереваОбъектов()
	
	ДеревоИсточник = РеквизитФормыВЗначение("ДеревоОбъектовПолное");
	ДеревоПриемник = РеквизитФормыВЗначение("ДеревоОбъектов");
	ДеревоПриемник.Строки.Очистить();
	
	Если Не ТолькоКонфликты Тогда
		Для Каждого СтрОбъект Из ДеревоИсточник.Строки Цикл
			НовОбъект = ДеревоПриемник.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НовОбъект, СтрОбъект);
			Для Каждого СтрЭлемент Из СтрОбъект.Строки Цикл
				НовЭлемент = НовОбъект.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(НовЭлемент, СтрЭлемент);
				Для Каждого СтрРасш Из СтрЭлемент.Строки Цикл
					НовРасш = НовЭлемент.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(НовРасш, СтрРасш);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	Иначе
		Для Каждого СтрОбъект Из ДеревоИсточник.Строки Цикл
			Если СтрОбъект.ЕстьКонфликт <> "Да" Тогда
				Продолжить;
			КонецЕсли;
			
			НовОбъект = Неопределено;
			Для Каждого СтрЭлемент Из СтрОбъект.Строки Цикл
				Если СтрЭлемент.ЕстьКонфликт <> "Да" Тогда
					Продолжить;
				КонецЕсли;
				
				Если НовОбъект = Неопределено Тогда
					НовОбъект = ДеревоПриемник.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(НовОбъект, СтрОбъект);
				КонецЕсли;
				
				НовЭлемент = НовОбъект.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(НовЭлемент, СтрЭлемент);
				Для Каждого СтрРасш Из СтрЭлемент.Строки Цикл
					НовРасш = НовЭлемент.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(НовРасш, СтрРасш);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДеревоПриемник, "ДеревоОбъектов");
	
	// Обновление счетчика в заголовке вкладки дерева
	Элементы.СтраницаОбъекты.Заголовок = "Дерево расширенных объектов (" + Строка(ДеревоПриемник.Строки.Количество()) + ")";
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовкиВкладок()
	
	Элементы.СтраницаКонфликты.Заголовок = "Конфликты и коллизии (" + Строка(ВсегоКонфликтов) + ")";
	Элементы.СтраницаРасширения.Заголовок = "Список расширений (" + Строка(ВсегоРасширений) + ")";
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьАнализНаСервере(МассивЭлементовСКлиента = Неопределено)
	
	ТаблицаКонфликтов.Очистить();
	ТаблицаРасширений.Очистить();
	
	ДеревоОбъектовПолноеДанные = РеквизитФормыВЗначение("ДеревоОбъектовПолное");
	ДеревоОбъектовПолноеДанные.Строки.Очистить();
	
	// 1. Получаем список расширений конфигурации
	МассивРасширений = РасширенияКонфигурации.Получить();
	ВсегоРасширений = МассивРасширений.Количество();
	
	// Таблица зарегистрированных элементов: методы, реквизиты, объекты
	ТЗ_Элементы = Новый ТаблицаЗначений;
	ТЗ_Элементы.Колонки.Добавить("ОбъектМетаданных", Новый ОписаниеТипов("Строка"));
	ТЗ_Элементы.Колонки.Добавить("ВидЭлемента", Новый ОписаниеТипов("Строка")); // "Объект", "Реквизит", "ТабличнаяЧасть", "Метод", "Форма"
	ТЗ_Элементы.Колонки.Добавить("ИмяЭлемента", Новый ОписаниеТипов("Строка"));
	ТЗ_Элементы.Колонки.Добавить("ТипПерехвата", Новый ОписаниеТипов("Строка")); // "&Вместо", "&Перед", "&После", "&ИзменениеИКонтроль", "Добавлен", "Заимствован"
	ТЗ_Элементы.Колонки.Добавить("Расширение", Новый ОписаниеТипов("Строка"));
	ТЗ_Элементы.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	ТЗ_Элементы.Колонки.Добавить("ВызываетПродолжитьВызов", Новый ОписаниеТипов("Булево"));
	ТЗ_Элементы.Колонки.Добавить("ТипДанных", Новый ОписаниеТипов("Строка"));
	
	ПорядковыйНомер = 0;
	Для Каждого Расширение Из МассивРасширений Цикл
		ПорядковыйНомер = ПорядковыйНомер + 1;
		
		СтрРасш = ТаблицаРасширений.Добавить();
		СтрРасш.Порядок = ПорядковыйНомер;
		СтрРасш.Имя = Расширение.Имя;
		СтрРасш.Синоним = Расширение.Синоним;
		СтрРасш.Версия = Расширение.Версия;
		СтрРасш.Активно = Расширение.Активно;
		СтрРасш.БезопасныйРежим = Расширение.БезопасныйРежим;
		СтрРасш.Назначение = Строка(Расширение.Назначение);
	КонецЦикла;
	
	// 2. Загружаем результаты клиентского сканирования XML/BSL
	Если МассивЭлементовСКлиента <> Неопределено И МассивЭлементовСКлиента.Количество() > 0 Тогда
		Для Каждого Эл Из МассивЭлементовСКлиента Цикл
			Стр = ТЗ_Элементы.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, Эл);
		КонецЦикла;
	КонецЕсли;
	
	// 3. Анализ коллизий и конфликтов
	ВыявитьКонфликты(ТЗ_Элементы);
	ЗаполнитьДеревоОбъектов(ТЗ_Элементы, ДеревоОбъектовПолноеДанные);
	ЗначениеВРеквизитФормы(ДеревоОбъектовПолноеДанные, "ДеревоОбъектовПолное");
	
	ПрименитьФильтрДереваОбъектов();
	
	ВсегоКонфликтов = ТаблицаКонфликтов.Количество();
	ОбновитьЗаголовкиВкладок();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ОбъектМетаданных, ВидЭлемента, ИмяЭлемента, ТипПерехвата, Расширение, Порядок, ВызываетПродолжитьВызов = Ложь, ТипДанных = "")
	
	ЭтоМетодИлиСобытие = (ВидЭлемента = "Метод" Или ВидЭлемента = "Событие");
	ВидДляКлюча = ?(ЭтоМетодИлиСобытие, "МЕТОД_СОБЫТИЕ", ВидЭлемента);
	ИмяДляКлюча = ?(ЭтоМетодИлиСобытие, ВРег(СтрЗаменить(ИмяЭлемента, ".", "")), ВРег(ИмяЭлемента));
	
	Ключ = ВРег(ОбъектМетаданных) + "|" + ВидДляКлюча + "|" + ИмяДляКлюча + "|" + ВРег(Расширение);
	СуществующаяЗапись = ИндексЭлементов.Получить(Ключ);
	
	Если СуществующаяЗапись = Неопределено Тогда
		Стр = Новый Структура;
		Стр.Вставить("ОбъектМетаданных", ОбъектМетаданных);
		Стр.Вставить("ВидЭлемента", ВидЭлемента);
		Стр.Вставить("ИмяЭлемента", ИмяЭлемента);
		Стр.Вставить("ТипПерехвата", ТипПерехвата);
		Стр.Вставить("Расширение", Расширение);
		Стр.Вставить("Порядок", Порядок);
		Стр.Вставить("ВызываетПродолжитьВызов", ВызываетПродолжитьВызов);
		Стр.Вставить("ТипДанных", ТипДанных);
		МассивЭлементов.Добавить(Стр);
		ИндексЭлементов.Вставить(Ключ, Стр);
	Иначе
		Если ВидЭлемента = "Событие" Тогда
			СуществующаяЗапись.ВидЭлемента = "Событие";
			Если СтрНайти(ИмяЭлемента, ".") > 0 Тогда
				СуществующаяЗапись.ИмяЭлемента = ИмяЭлемента;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоМетодИлиСобытие Тогда
			Если ЗначениеЗаполнено(ТипПерехвата) И СтрНайти(СуществующаяЗапись.ТипПерехвата, ТипПерехвата) = 0 Тогда
				СуществующаяЗапись.ТипПерехвата = СуществующаяЗапись.ТипПерехвата + " + " + ТипПерехвата;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТипДанных) И СтрНайти(СуществующаяЗапись.ТипДанных, ТипДанных) = 0 Тогда
				СуществующаяЗапись.ТипДанных = ?(ЗначениеЗаполнено(СуществующаяЗапись.ТипДанных), СуществующаяЗапись.ТипДанных + ", " + ТипДанных, ТипДанных);
			КонецЕсли;
		Иначе
			СуществующаяЗапись.ТипПерехвата = ТипПерехвата;
			Если ЗначениеЗаполнено(ТипДанных) Тогда
				СуществующаяЗапись.ТипДанных = ТипДанных;
			КонецЕсли;
		КонецЕсли;
		
		Если ВызываетПродолжитьВызов Тогда
			СуществующаяЗапись.ВызываетПродолжитьВызов = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

