	Словарь.Вставить("ONSTART", "ПриНачалеРаботыСистемы");
	Словарь.Вставить("ПРИНАЧАЛЕРАБОТЫСИСТЕМЫ", "ПриНачалеРаботыСистемы");
	Словарь.Вставить("BEFORESTART", "ПередНачаломРаботыСистемы");
	Словарь.Вставить("ПЕРЕДНАЧАЛОМРАБОТЫСИСТЕМЫ", "ПередНачаломРаботыСистемы");
	Словарь.Вставить("ONEXIT", "ПриЗавершенииРаботыСистемы");
	Словарь.Вставить("ПРИЗАВЕРШЕНИИРАБОТЫСИСТЕМЫ", "ПриЗавершенииРаботыСистемы");
	Словарь.Вставить("BEFOREEXIT", "ПередЗавершениемРаботыСистемы");
	Словарь.Вставить("ПЕРЕДЗАВЕРШЕНИЕМРАБОТЫСИСТЕМЫ", "ПередЗавершениемРаботыСистемы");
	Словарь.Вставить("SESSIONPARAMETERSSETTING", "УстановкаПараметровСеанса");
	Словарь.Вставить("УСТАНОВКАПАРАМЕТРОВСЕАНСА", "УстановкаПараметровСеанса");
	Словарь.Вставить("PRESENTATIONGETPROCESSING", "ОбработкаПолученияПредставления");
	Словарь.Вставить("ОБРАБОТКАПОЛУЧЕНИЯПРЕДСТАВЛЕНИЯ", "ОбработкаПолученияПредставления");
	Словарь.Вставить("PRESENTATIONFIELDSGETPROCESSING", "ОбработкаПолученияПолейПредставления");
	Словарь.Вставить("ОБРАБОТКАПОЛУЧЕНИЯПОЛЕЙПРЕДСТАВЛЕНИЯ", "ОбработкаПолученияПолейПредставления");
	Словарь.Вставить("CHOICEHISTORYONWRITE", "ОбработкаПолученияДанныхВыбора");
	Словарь.Вставить("ОБРАБОТКАПОЛУЧЕНИЯДАННЫХВЫБОРА", "ОбработкаПолученияДанныхВыбора");
	
	Возврат Словарь;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СканироватьВыгруженныеИсходники(ПутьККаталогу, СоответствиеАктивныхРасширений, МассивЭлементов, ИндексЭлементов)
	
	КаталогФайлов = Новый Файл(ПутьККаталогу);
	Если Не КаталогФайлов.Существует() Или Не КаталогФайлов.ЭтоКаталог() Тогда
		Возврат;
	КонецЕсли;
	
	// Таблица соответствия английских папок метаданных русским классам
	СоответствиеКлассов = Новый Соответствие;
	СоответствиеКлассов.Вставить("COMMONMODULES", "ОбщийМодуль");
	СоответствиеКлассов.Вставить("COMMONFORMS", "ОбщаяФорма");
	СоответствиеКлассов.Вставить("COMMONCOMMANDS", "ОбщаяКоманда");
	СоответствиеКлассов.Вставить("EVENTSUBSCRIPTIONS", "ПодпискаНаСобытие");
	СоответствиеКлассов.Вставить("SCHEDULEDJOBS", "РегламентноеЗадание");
	СоответствиеКлассов.Вставить("DOCUMENTS", "Документ");
	СоответствиеКлассов.Вставить("DOCUMENTJOURNALS", "ЖурналДокументов");
	СоответствиеКлассов.Вставить("CATALOGS", "Справочник");
	СоответствиеКлассов.Вставить("REPORTS", "Отчет");
	СоответствиеКлассов.Вставить("DATAPROCESSORS", "Обработка");
	СоответствиеКлассов.Вставить("INFORMATIONREGISTERS", "РегистрСведений");
	СоответствиеКлассов.Вставить("ACCUMULATIONREGISTERS", "РегистрНакопления");
	СоответствиеКлассов.Вставить("ACCOUNTINGREGISTERS", "РегистрБухгалтерии");
	СоответствиеКлассов.Вставить("CALCULATIONREGISTERS", "РегистрРасчета");
	СоответствиеКлассов.Вставить("BUSINESSPROCESSES", "БизнесПроцесс");
	СоответствиеКлассов.Вставить("TASKS", "Задача");
	СоответствиеКлассов.Вставить("CHARTSOFCHARACTERISTICTYPES", "ПланВидовХарактеристик");
	СоответствиеКлассов.Вставить("CHARTSOFACCOUNTS", "ПланСчетов");
	СоответствиеКлассов.Вставить("CHARTSOFCALCULATIONTYPES", "ПланВидовРасчета");
	СоответствиеКлассов.Вставить("EXCHANGEPLANS", "ПланОбмена");
	СоответствиеКлассов.Вставить("CONSTANTS", "Константа");
	СоответствиеКлассов.Вставить("ENUMS", "Перечисление");
	СоответствиеКлассов.Вставить("HTTPSERVICES", "HTTPСервис");
	СоответствиеКлассов.Вставить("WEBSERVICES", "WebСервис");
	СоответствиеКлассов.Вставить("DEFINEDTYPES", "ОпределяемыйТип");
	
	СловарьСобытий = СоздатьСловарьСтандартныхСобытий();
	
	// Находим корневые каталоги всех выгруженных расширений по наличию Configuration.xml
	МассивКаталоговРасширений = Новый Массив;
	
	// Ищем Configuration.xml в корне переданного каталога или в непосредственных подкаталогах
	МассивФайловКонфигураций = Новый Массив;
	КонфВКорне = НайтиФайлы(ПутьККаталогу, "Configuration.xml", Ложь);
	Для Каждого Ф Из КонфВКорне Цикл
		МассивФайловКонфигураций.Добавить(Ф);
	КонецЦикла;
	
	ПодпапкиКаталога = НайтиФайлы(ПутьККаталогу, "*", Ложь);
	Для Каждого Подпапка Из ПодпапкиКаталога Цикл
		Если Подпапка.ЭтоКаталог() Тогда
			КонфВПодпапке = НайтиФайлы(Подпапка.ПолноеИмя, "Configuration.xml", Ложь);
			Для Каждого Ф Из КонфВПодпапке Цикл
				МассивФайловКонфигураций.Добавить(Ф);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ФайлКонф Из МассивФайловКонфигураций Цикл
		ПапкаРасш = Новый Файл(ФайлКонф.Путь);
		СведенияОКонф = ПолучитьСведенияОКонфигурацииXML(ФайлКонф.ПолноеИмя);
		
		// Обрабатываем только расширения, игнорируя основные конфигурации
		Если Не СведенияОКонф.ЭтоРасширение Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРасширенияXML = ?(ЗначениеЗаполнено(СведенияОКонф.Имя), СведенияОКонф.Имя, ПапкаРасш.Имя);
		
		// Если передан список активных расширений базы, проверяем соответствие
		Если СоответствиеАктивныхРасширений.Количество() > 0 Тогда
			Если СоответствиеАктивныхРасширений.Получить(ВРег(ИмяРасширенияXML)) = Неопределено
				И СоответствиеАктивныхРасширений.Получить(ВРег(ПапкаРасш.Имя)) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураКаталога = Новый Структура("Каталог, ИмяРасширения", ПапкаРасш, ИмяРасширенияXML);
		МассивКаталоговРасширений.Добавить(СтруктураКаталога);
	КонецЦикла;
	
	Для Каждого ЭлементКаталога Из МассивКаталоговРасширений Цикл
		КаталогРасш = ЭлементКаталога.Каталог;
		ИмяРасширения = ЭлементКаталога.ИмяРасширения;
		
		ПорядковыйНомер = СоответствиеАктивныхРасширений.Получить(ВРег(ИмяРасширения));
		Если ПорядковыйНомер = Неопределено Тогда
			ПорядковыйНомер = СоответствиеАктивныхРасширений.Получить(ВРег(КаталогРасш.Имя));
		КонецЕсли;
		Если ПорядковыйНомер = Неопределено Тогда
			ПорядковыйНомер = 1;
		КонецЕсли;
		
		ПутьКРасширению = КаталогРасш.ПолноеИмя;
		Если Прав(ПутьКРасширению, 1) <> "\" И Прав(ПутьКРасширению, 1) <> "/" Тогда
			ПутьКРасширению = ПутьКРасширению + "\";
		КонецЕсли;
		
		// 1. Быстрый обход папок классов метаданных (читаем корневые XML объектов + Form.xml только у заимствованных форм)
		ПодпапкиКлассов = НайтиФайлы(ПутьКРасширению, "*", Ложь);
		Для Каждого ПапкаКласса Из ПодпапкиКлассов Цикл
			Если Не ПапкаКласса.ЭтоКаталог() Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяПапкиКлассаВРег = ВРег(ПапкаКласса.Имя);
			КлассРус = СоответствиеКлассов.Получить(ИмяПапкиКлассаВРег);
			Если КлассРус = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// Читаем только корневые XML-файлы самих объектов в папке класса
			ФайлыОбъектовXML = НайтиФайлы(ПапкаКласса.ПолноеИмя, "*.xml", Ложь);
			Для Каждого ФайлXML Из ФайлыОбъектовXML Цикл
				ИмяОбъекта = ФайлXML.ИмяБезРасширения;
				ПолноеИмяОбъекта = КлассРус + "." + ИмяОбъекта;
				
				ТекстXML = "";
				Попытка
					ЧтениеТекстаXML = Новый ЧтениеТекста(ФайлXML.ПолноеИмя, КодировкаТекста.UTF8);
					ТекстXML = ЧтениеТекстаXML.Прочитать();
					ЧтениеТекстаXML.Закрыть();
				Исключение
					Продолжить;
				КонецПопытки;
				
				// Определяем принадлежность самого объекта (до секции <ChildObjects>)
				ПозДочерних = СтрНайти(ТекстXML, "<ChildObjects>");
				ШапкаОбъектаXML = ?(ПозДочерних > 0, Лев(ТекстXML, ПозДочерних), ТекстXML);
				ЭтоЗаимствованный = (СтрНайти(ШапкаОбъектаXML, "<ObjectBelonging>Adopted</ObjectBelonging>") > 0);
				
				ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ПолноеИмяОбъекта, "Объект", ИмяОбъекта, ?(ЭтоЗаимствованный, "Заимствован", "Создан в расширении"), ИмяРасширения, ПорядковыйНомер);
				
				// Если это ПодпискаНаСобытие - разбираем <Source> и <Event> для выявления пересечений обработчиков событий объектов
				Если ИмяПапкиКлассаВРег = "EVENTSUBSCRIPTIONS" Тогда
					РазобратьПодпискуНаСобытиеXML(ТекстXML, ИмяОбъекта, ИмяРасширения, ПорядковыйНомер, СловарьСобытий, МассивЭлементов, ИндексЭлементов);
				КонецЕсли;
				
				// Если это заимствованная ОбщаяФорма - проверяем её Ext\Form.xml на перехватчики событий (callType="Before|After|Override")
				Если ИмяПапкиКлассаВРег = "COMMONFORMS" И ЭтоЗаимствованный Тогда
					ПутьКFormXML = ПапкаКласса.ПолноеИмя + "\" + ИмяОбъекта + "\Ext\Form.xml";
					ПутьКМодулюФормы = ПапкаКласса.ПолноеИмя + "\" + ИмяОбъекта + "\Ext\Form\Module.bsl";
					СканироватьФормуXML(ПутьКFormXML, ПутьКМодулюФормы, ПолноеИмяОбъекта, ИмяРасширения, ПорядковыйНомер, СловарьСобытий, МассивЭлементов, ИндексЭлементов);
				КонецЕсли;
				
				// Если есть вложенные реквизиты/измерения/ресурсы/ТЧ/формы в <ChildObjects>, разбираем их
				Если ПозДочерних > 0 Тогда
					ТекстДочерних = Сред(ТекстXML, ПозДочерних);
					КаталогОбъекта = ПапкаКласса.ПолноеИмя + "\" + ИмяОбъекта;
					РазобратьДочерниеЭлементыXML(ТекстДочерних, ПолноеИмяОбъекта, КаталогОбъекта, ЭтоЗаимствованный, ИмяРасширения, ПорядковыйНомер, СловарьСобытий, МассивЭлементов, ИндексЭлементов);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		// 2. Поиск и быстрый разбор модулей исходного кода (*.bsl)
		ФайлыBSL = НайтиФайлы(ПутьКРасширению, "*.bsl", Истина);
		Для Каждого ФайлBSL Из ФайлыBSL Цикл
			
			ОтносительныйПуть = СтрЗаменить(ФайлBSL.ПолноеИмя, ПутьКРасширению, "");
			ОтносительныйПуть = СтрЗаменить(ОтносительныйПуть, "/", "\");
			МассивЧастей = СтрРазделить(ОтносительныйПуть, "\");
			
			ЦелевойОбъектМД = "Конфигурация";
			Если МассивЧастей.Количество() > 0 Тогда
				КлассАнгл = ВРег(МассивЧастей[0]);
				Если КлассАнгл = "EXT" И МассивЧастей.Количество() > 1 Тогда
					ИмяМодуляКонф = ВРег(МассивЧастей[1]);
					Если ИмяМодуляКонф = "MANAGEDAPPLICATIONMODULE.BSL" Тогда
						ЦелевойОбъектМД = "Конфигурация.МодульУправляемогоПриложения";
					ИначеЕсли ИмяМодуляКонф = "ORDINARYAPPLICATIONMODULE.BSL" Тогда
						ЦелевойОбъектМД = "Конфигурация.МодульОбычногоПриложения";
					ИначеЕсли ИмяМодуляКонф = "SESSIONMODULE.BSL" Тогда
						ЦелевойОбъектМД = "Конфигурация.МодульСеанса";
					ИначеЕсли ИмяМодуляКонф = "EXTERNALCONNECTIONMODULE.BSL" Тогда
						ЦелевойОбъектМД = "Конфигурация.МодульВнешнегоСоединения";
					КонецЕсли;
				Иначе
					КлассРус = СоответствиеКлассов.Получить(КлассАнгл);
					Если КлассРус <> Неопределено И МассивЧастей.Количество() > 1 Тогда
						ЦелевойОбъектМД = КлассРус + "." + МассивЧастей[1];
						Если МассивЧастей.Количество() > 3 Тогда
							ПодпапкаВРег = ВРег(МассивЧастей[2]);
							Если ПодпапкаВРег = "FORMS" Тогда
								ЦелевойОбъектМД = ЦелевойОбъектМД + ".Форма." + МассивЧастей[3];
							ИначеЕсли ПодпапкаВРег = "COMMANDS" Тогда
								ЦелевойОбъектМД = ЦелевойОбъектМД + ".Команда." + МассивЧастей[3];
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			СканироватьФайлBSL(ФайлBSL.ПолноеИмя, ЦелевойОбъектМД, ИмяРасширения, ПорядковыйНомер, СловарьСобытий, МассивЭлементов, ИндексЭлементов);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РазобратьДочерниеЭлементыXML(ТекстДочерних, ПолноеИмяОбъекта, КаталогОбъекта, ОбъектЗаимствован, ИмяРасширения, ПорядковыйНомер, СловарьСобытий, МассивЭлементов, ИндексЭлементов)
	
	ТекстБезТЧ = ТекстДочерних;
	
	// 1. Сначала разбираем табличные части (<TabularSection>) и их реквизиты
	ПозТЧ = СтрНайти(ТекстДочерних, "<TabularSection ");
	Пока ПозТЧ > 0 Цикл
		ПозКонТЧ = СтрНайти(ТекстДочерних, "</TabularSection>", , ПозТЧ);
		Если ПозКонТЧ = 0 Тогда
			Прервать;
		КонецЕсли;
		
		БлокТЧ = Сред(ТекстДочерних, ПозТЧ, ПозКонТЧ - ПозТЧ);
		ПозДочернихТЧ = СтрНайти(БлокТЧ, "<ChildObjects>");
		ШапкаТЧ = ?(ПозДочернихТЧ > 0, Лев(БлокТЧ, ПозДочернихТЧ), БлокТЧ);
		ИмяТЧ = ИзвлечьЗначениеТегаXML(ШапкаТЧ, "Name");
		Если ЗначениеЗаполнено(ИмяТЧ) Тогда
			ТЧЗаимствована = (СтрНайти(ШапкаТЧ, "<ObjectBelonging>Adopted</ObjectBelonging>") > 0);
			ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ПолноеИмяОбъекта, "ТабличнаяЧасть", ИмяТЧ, ?(ТЧЗаимствована, "Заимствована ТЧ", "Добавлена ТЧ"), ИмяРасширения, ПорядковыйНомер);
			
			Если ПозДочернихТЧ > 0 Тогда
				ДочерниеТЧ = Сред(БлокТЧ, ПозДочернихТЧ);
				ПозРеквТЧ = СтрНайти(ДочерниеТЧ, "<Attribute ");
				Пока ПозРеквТЧ > 0 Цикл
					ПозКонРеквТЧ = СтрНайти(ДочерниеТЧ, "</Attribute>", , ПозРеквТЧ);
					Если ПозКонРеквТЧ = 0 Тогда
						Прервать;
					КонецЕсли;
					БлокРеквТЧ = Сред(ДочерниеТЧ, ПозРеквТЧ, ПозКонРеквТЧ - ПозРеквТЧ);
					ИмяРеквТЧ = ИзвлечьЗначениеТегаXML(БлокРеквТЧ, "Name");
					Если ЗначениеЗаполнено(ИмяРеквТЧ) Тогда
						РеквТЧЗаимствован = (СтрНайти(БлокРеквТЧ, "<ObjectBelonging>Adopted</ObjectBelonging>") > 0);
						ТипРеквТЧ = ИзвлечьТипыИзБлокаXML(БлокРеквТЧ);
						ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ПолноеИмяОбъекта + "." + ИмяТЧ, "Реквизит", ИмяРеквТЧ, ?(РеквТЧЗаимствован, "Заимствованный реквизит", "Добавлен реквизит"), ИмяРасширения, ПорядковыйНомер, Ложь, ТипРеквТЧ);
					КонецЕсли;
					ПозРеквТЧ = СтрНайти(ДочерниеТЧ, "<Attribute ", , ПозКонРеквТЧ + 12);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		ПозТЧ = СтрНайти(ТекстДочерних, "<TabularSection ", , ПозКонТЧ + 17);
	КонецЦикла;
	
	// Убираем блоки TabularSection, чтобы не дублировать их реквизиты как реквизиты шапки
	ПозУдаленияТЧ = СтрНайти(ТекстБезТЧ, "<TabularSection ");
	Пока ПозУдаленияТЧ > 0 Цикл
		ПозКонУдаленияТЧ = СтрНайти(ТекстБезТЧ, "</TabularSection>", , ПозУдаленияТЧ);
		Если ПозКонУдаленияТЧ = 0 Тогда
			Прервать;
		КонецЕсли;
		ТекстБезТЧ = Лев(ТекстБезТЧ, ПозУдаленияТЧ - 1) + Сред(ТекстБезТЧ, ПозКонУдаленияТЧ + 17);
		ПозУдаленияТЧ = СтрНайти(ТекстБезТЧ, "<TabularSection ");
	КонецЦикла;
	
	// 2. Разбираем реквизиты (<Attribute>), измерения (<Dimension>), ресурсы (<Resource>) самого объекта
	МассивТеговРеквизитов = Новый Массив;
	МассивТеговРеквизитов.Добавить("Attribute");
	МассивТеговРеквизитов.Добавить("Dimension");
	МассивТеговРеквизитов.Добавить("Resource");
	
	Для Каждого ИмяТега Из МассивТеговРеквизитов Цикл
		ОткрывающийТег = "<" + ИмяТега + " ";
		ЗакрывающийТег = "</" + ИмяТега + ">";
		ПозНач = СтрНайти(ТекстБезТЧ, ОткрывающийТег);
		Пока ПозНач > 0 Цикл
			ПозКон = СтрНайти(ТекстБезТЧ, ЗакрывающийТег, , ПозНач);
			Если ПозКон = 0 Тогда
				Прервать;
			КонецЕсли;
			
			БлокРеквизита = Сред(ТекстБезТЧ, ПозНач, ПозКон - ПозНач);
			ИмяРеквизита = ИзвлечьЗначениеТегаXML(БлокРеквизита, "Name");
			Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
				РеквЗаимствован = (СтрНайти(БлокРеквизита, "<ObjectBelonging>Adopted</ObjectBelonging>") > 0);
				ТипРеквизита = ИзвлечьТипыИзБлокаXML(БлокРеквизита);
				ВидОписания = ?(РеквЗаимствован, "Заимствованный реквизит", "Добавлен реквизит");
				ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ПолноеИмяОбъекта, "Реквизит", ИмяРеквизита, ВидОписания, ИмяРасширения, ПорядковыйНомер, Ложь, ТипРеквизита);
			КонецЕсли;
			
			ПозНач = СтрНайти(ТекстБезТЧ, ОткрывающийТег, , ПозКон + СтрДлина(ЗакрывающийТег));
		КонецЦикла;
	КонецЦикла;
	
	// 3. Разбираем формы (<Form>ИмяФормы</Form>) и у заимствованных форм сканируем события в Form.xml
	ПозФормы = СтрНайти(ТекстБезТЧ, "<Form>");
	Пока ПозФормы > 0 Цикл
		ПозКонФормы = СтрНайти(ТекстБезТЧ, "</Form>", , ПозФормы);
		Если ПозКонФормы = 0 Тогда
			Прервать;
		КонецЕсли;
		ИмяФормы = СокрЛП(Сред(ТекстБезТЧ, ПозФормы + 6, ПозКонФормы - ПозФормы - 6));
		Если ЗначениеЗаполнено(ИмяФормы) И СтрНайти(ИмяФормы, "<") = 0 Тогда
			ФормаЗаимствована = Ложь;
			Если ОбъектЗаимствован И ЗначениеЗаполнено(КаталогОбъекта) Тогда
				ПутьДескриптораФормы = КаталогОбъекта + "\Forms\" + ИмяФормы + ".xml";
				ФайлДескриптора = Новый Файл(ПутьДескриптораФормы);
				Если ФайлДескриптора.Существует() Тогда
					Попытка
						ЧтениеДескр = Новый ЧтениеТекста(ПутьДескриптораФормы, КодировкаТекста.UTF8);
						ТекстДескр = ЧтениеДескр.Прочитать();
						ЧтениеДескр.Закрыть();
						ФормаЗаимствована = (СтрНайти(ТекстДескр, "<ObjectBelonging>Adopted</ObjectBelonging>") > 0);
					Исключение
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
			
			ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ПолноеИмяОбъекта, "Форма", ИмяФормы, ?(ФормаЗаимствована, "Заимствована форма", "Форма"), ИмяРасширения, ПорядковыйНомер);
			
			// Если форма заимствована - сканируем её Form.xml на обработчики событий (Перед / После / Вместо)
			Если ФормаЗаимствована Тогда
				ПутьКFormXML = КаталогОбъекта + "\Forms\" + ИмяФормы + "\Ext\Form.xml";
				ПутьКМодулюФормы = КаталогОбъекта + "\Forms\" + ИмяФормы + "\Ext\Form\Module.bsl";
				ЦелевойОбъектФормы = ПолноеИмяОбъекта + ".Форма." + ИмяФормы;
				СканироватьФормуXML(ПутьКFormXML, ПутьКМодулюФормы, ЦелевойОбъектФормы, ИмяРасширения, ПорядковыйНомер, СловарьСобытий, МассивЭлементов, ИндексЭлементов);
			КонецЕсли;
		КонецЕсли;
		ПозФормы = СтрНайти(ТекстБезТЧ, "<Form>", , ПозКонФормы + 7);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИзвлечьТелоМетода(ТекстМодуля, ПозицияНачала)
	ТекстВРег = ВРег(ТекстМодуля);
	ДлинаТекста = СтрДлина(ТекстМодуля);
	
	// Ищем ближайший КонецПроцедуры / КонецФункции после ПозицияНачала
	ПозКонПроц = СтрНайти(ТекстВРег, "КОНЕЦПРОЦЕДУРЫ", , ПозицияНачала);
	ПозКонФунк = СтрНайти(ТекстВРег, "КОНЕЦФУНКЦИИ", , ПозицияНачала);
	ПозКонProc = СтрНайти(ТекстВРег, "ENDPROCEDURE", , ПозицияНачала);
	ПозКонFunc = СтрНайти(ТекстВРег, "ENDFUNCTION", , ПозицияНачала);
	
	ПозОкончания = ДлинаТекста;
	Если ПозКонПроц > 0 И ПозКонПроц < ПозОкончания Тогда
		ПозОкончания = ПозКонПроц;
	КонецЕсли;
	Если ПозКонФунк > 0 И ПозКонФунк < ПозОкончания Тогда
		ПозОкончания = ПозКонФунк;
	КонецЕсли;
	Если ПозКонProc > 0 И ПозКонProc < ПозОкончания Тогда
		ПозОкончания = ПозКонProc;
	КонецЕсли;
	Если ПозКонFunc > 0 И ПозКонFunc < ПозОкончания Тогда
		ПозОкончания = ПозКонFunc;
	КонецЕсли;
	
	Если ПозОкончания > ПозицияНачала Тогда
		Возврат Сред(ТекстМодуля, ПозицияНачала, ПозОкончания - ПозицияНачала + 14);
	Иначе
		Возврат Сред(ТекстМодуля, ПозицияНачала);
	КонецЕсли;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СканироватьФормуXML(ПутьКFormXML, ПутьКМодулюФормы, ЦелевойОбъектФормы, ИмяРасширения, ПорядковыйНомер, СловарьСобытий, МассивЭлементов, ИндексЭлементов)
	
	ФайлФормы = Новый Файл(ПутьКFormXML);
	Если Не ФайлФормы.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстFormXML = "";
	Попытка
		ЧтениеФормы = Новый ЧтениеТекста(ПутьКFormXML, КодировкаТекста.UTF8);
		ТекстFormXML = ЧтениеФормы.Прочитать();
		ЧтениеФормы.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
	// Быстрая отсечка: если в Form.xml нет ни одного атрибута callType=, выходим мгновенно
	Если Не ЗначениеЗаполнено(ТекстFormXML) Или СтрНайти(ТекстFormXML, "callType=") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// При наличии callType="Override" читаем модуль формы для проверки ПродолжитьВызов()
	ТекстМодуляФормы = "";
	Если СтрНайти(ТекстFormXML, "callType=""Override""") > 0 Тогда
		ФайлМодуля = Новый Файл(ПутьКМодулюФормы);
		Если ФайлМодуля.Существует() Тогда
			Попытка
				ЧтениеМод = Новый ЧтениеТекста(ПутьКМодулюФормы, КодировкаТекста.UTF8);
				ТекстМодуляФормы = ЧтениеМод.Прочитать();
				ЧтениеМод.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	ПозКорневыхЭлементов = СтрНайти(ТекстFormXML, "<ChildItems>");
	
	ПозCallType = СтрНайти(ТекстFormXML, "callType=""");
	Пока ПозCallType > 0 Цикл
		// Находим открывающий и закрывающий теги вокруг callType="..."
		ПозОткрТега = СтрНайти(ТекстFormXML, "<", НаправлениеПоиска.СКонца, ПозCallType);
		ПозЗакрОткрТега = СтрНайти(ТекстFormXML, ">", , ПозCallType);
		Если ПозОткрТега = 0 Или ПозЗакрОткрТега = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПозЗакрТега = СтрНайти(ТекстFormXML, "</", , ПозЗакрОткрТега);
		Если ПозЗакрТега = 0 Тогда
			Прервать;
		КонецЕсли;
		
		СтрокаОткрТега = Сред(ТекстFormXML, ПозОткрТега, ПозЗакрОткрТега - ПозОткрТега + 1);
		ИмяОбработчика = СокрЛП(Сред(ТекстFormXML, ПозЗакрОткрТега + 1, ПозЗакрТега - ПозЗакрОткрТега - 1));
		
		ЗначениеCallType = ИзвлечьАтрибутXML(СтрокаОткрТега, "callType");
		Директива = "&После";
		Если ВРег(ЗначениеCallType) = "BEFORE" Тогда
			Директива = "&Перед";
		ИначеЕсли ВРег(ЗначениеCallType) = "AFTER" Тогда
			Директива = "&После";
		ИначеЕсли ВРег(ЗначениеCallType) = "OVERRIDE" Тогда
			Директива = "&Вместо";
		КонецЕсли;
		
		ЕстьПродолжитьВызов = Ложь;
		Если Директива = "&Вместо" И ЗначениеЗаполнено(ТекстМодуляФормы) И ЗначениеЗаполнено(ИмяОбработчика) Тогда
			ПозПроц = СтрНайти(ВРег(ТекстМодуляФормы), ВРег(ИмяОбработчика));
			Если ПозПроц > 0 Тогда
				ФрагментПроц = ИзвлечьТелоМетода(ТекстМодуляФормы, ПозПроц);
				ЕстьПродолжитьВызов = (СтрНайти(ФрагментПроц, "ПродолжитьВызов(") > 0 Или СтрНайти(ФрагментПроц, "ProceedWithCall(") > 0);
			КонецЕсли;
		КонецЕсли;
		
		Если СтрНачинаетсяС(СтрокаОткрТега, "<Action") Тогда
			// Это расширение действия команды формы (<Command name="..."><Action callType="...">)
			ИмяКоманды = НайтиИмяРодительскогоТегаПоОтступу(ТекстFormXML, ПозОткрТега);
			Если ЗначениеЗаполнено(ИмяКоманды) Тогда
				ИмяЭлементаСобытия = "Команда." + ИмяКоманды + ".Действие";
			Иначе
				ИмяЭлементаСобытия = "Команда.Действие";
			КонецЕсли;
			ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ЦелевойОбъектФормы, "Событие", ИмяЭлементаСобытия, Директива, ИмяРасширения, ПорядковыйНомер, ЕстьПродолжитьВызов, ИмяОбработчика);
			
		ИначеЕсли СтрНачинаетсяС(СтрокаОткрТега, "<Event") Тогда
			ИмяСобытияXML = ИзвлечьАтрибутXML(СтрокаОткрТега, "name");
			
			// Проверяем, событие ли это самой формы (до <ChildItems>) или элемента формы (внутри <ChildItems>)
			Если ПозКорневыхЭлементов = 0 Или ПозОткрТега < ПозКорневыхЭлементов Тогда
				ИмяСобытияРус = ОпределитьРусскоеИмяСобытияФормы(ИмяСобытияXML, "", ИмяОбработчика, СловарьСобытий);
				ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ЦелевойОбъектФормы, "Событие", ИмяСобытияРус, Директива, ИмяРасширения, ПорядковыйНомер, ЕстьПродолжитьВызов, ИмяОбработчика);
			Иначе
				ПозТегаEvents = СтрНайти(ТекстFormXML, "<Events>", НаправлениеПоиска.СКонца, ПозОткрТега);
				ИмяЭлементаФормы = "";
				Если ПозТегаEvents > 0 Тогда
					ИмяЭлементаФормы = НайтиИмяРодительскогоТегаПоОтступу(ТекстFormXML, ПозТегаEvents);
				КонецЕсли;
				ИмяСобытияРус = ОпределитьРусскоеИмяСобытияФормы(ИмяСобытияXML, ИмяЭлементаФормы, ИмяОбработчика, СловарьСобытий);
				ПолноеИмяСобытияЭлемента = ?(ЗначениеЗаполнено(ИмяЭлементаФормы), ИмяЭлементаФормы + "." + ИмяСобытияРус, ИмяСобытияРус);
				ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ЦелевойОбъектФормы, "Событие", ПолноеИмяСобытияЭлемента, Директива, ИмяРасширения, ПорядковыйНомер, ЕстьПродолжитьВызов, ИмяОбработчика);
			КонецЕсли;
		КонецЕсли;
		
		ПозCallType = СтрНайти(ТекстFormXML, "callType=""", , ПозЗакрТега + 2);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиИмяРодительскогоТегаПоОтступу(ТекстXML, ПозицияДочернегоТега)
	
	// Находим начало строки, на которой расположен дочерний тег (<Events> или <Action>)
	ПозНачСтроки = СтрНайти(ТекстXML, Символы.ПС, НаправлениеПоиска.СКонца, ПозицияДочернегоТега);
	Если ПозНачСтроки = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ОтступДочернего = Сред(ТекстXML, ПозНачСтроки + 1, ПозицияДочернегоТега - ПозНачСтроки - 1);
	Если СтрДлина(ОтступДочернего) <= 1 Тогда
		Возврат "";
	КонецЕсли;
	
	// Родительский тег в XML выгрузке 1С имеет ровно на 1 символ табуляции меньше
	ОтступРодителя = Лев(ОтступДочернего, СтрДлина(ОтступДочернего) - 1);
	ИскомыйШаблон = Символы.ПС + ОтступРодителя + "<";
	
	ПозКандидата = СтрНайти(ТекстXML, ИскомыйШаблон, НаправлениеПоиска.СКонца, ПозНачСтроки);
	Пока ПозКандидата > 0 Цикл
		ПозОткр = ПозКандидата + СтрДлина(ИскомыйШаблон) - 1;
		СледСимвол = Сред(ТекстXML, ПозОткр + 1, 1);
		// Пропускаем закрывающие теги </...> и теги с большим числом табов
		Если СледСимвол <> "/" И СледСимвол <> Символы.Таб Тогда
			ПозЗакр = СтрНайти(ТекстXML, ">", , ПозОткр);
			Если ПозЗакр > 0 Тогда
				СтрокаТега = Сред(ТекстXML, ПозОткр, ПозЗакр - ПозОткр + 1);
				ИмяАтр = ИзвлечьАтрибутXML(СтрокаТега, "name");
				Если ЗначениеЗаполнено(ИмяАтр) Тогда
					Возврат ИмяАтр;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ПозКандидата <= 1 Тогда
			Прервать;
		КонецЕсли;
		ПозКандидата = СтрНайти(ТекстXML, ИскомыйШаблон, НаправлениеПоиска.СКонца, ПозКандидата - 1);
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьРусскоеИмяСобытияФормы(ИмяСобытияXML, ИмяЭлементаФормы, ИмяОбработчика, СловарьСобытий)
	
	// 1. Сначала проверяем по словарю стандартных событий (включая платформенные UUID)
	НайденноеВСловаре = СловарьСобытий.Получить(ВРег(ИмяСобытияXML));
	Если НайденноеВСловаре <> Неопределено Тогда
		Возврат НайденноеВСловаре;
	КонецЕсли;
	
	// 2. Если в XML записан платформенный UUID события, извлекаем имя события из имени процедуры-обработчика
	Если ЗначениеЗаполнено(ИмяОбработчика) Тогда
		Кандидат = ИмяОбработчика;
		Если ЗначениеЗаполнено(ИмяЭлементаФормы) Тогда
			ПозЭл = СтрНайти(ВРег(Кандидат), ВРег(ИмяЭлементаФормы));
			Если ПозЭл > 0 Тогда
				Кандидат = Сред(Кандидат, ПозЭл + СтрДлина(ИмяЭлементаФормы));
			КонецЕсли;
		Иначе
			ПозПодчерк = СтрНайти(Кандидат, "_");
			Если ПозПодчерк > 0 Тогда
				Кандидат = Сред(Кандидат, ПозПодчерк + 1);
			КонецЕсли;
		КонецЕсли;
		
		// Отрезаем типовой суффикс направления перехвата (После / Перед / Вместо)
		КандидатВРег = ВРег(Кандидат);
		Если СтрЗаканчиваетсяНа(КандидатВРег, "ПОСЛЕ") И СтрДлина(Кандидат) > 5 Тогда
			Кандидат = Лев(Кандидат, СтрДлина(Кандидат) - 5);
		ИначеЕсли СтрЗаканчиваетсяНа(КандидатВРег, "ПЕРЕД") И СтрДлина(Кандидат) > 5 Тогда
			Кандидат = Лев(Кандидат, СтрДлина(Кандидат) - 5);
		ИначеЕсли СтрЗаканчиваетсяНа(КандидатВРег, "ВМЕСТО") И СтрДлина(Кандидат) > 6 Тогда
			Кандидат = Лев(Кандидат, СтрДлина(Кандидат) - 6);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Кандидат) Тогда
			Проверенное = СловарьСобытий.Получить(ВРег(Кандидат));
			Если Проверенное <> Неопределено Тогда
				Возврат Проверенное;
			КонецЕсли;
			Возврат Кандидат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИмяСобытияXML;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РазобратьПодпискуНаСобытиеXML(ТекстXML, ИмяПодписки, ИмяРасширения, ПорядковыйНомер, СловарьСобытий, МассивЭлементов, ИндексЭлементов)
	
	ИмяСобытияXML = ИзвлечьЗначениеТегаXML(ТекстXML, "Event");
	Если Не ЗначениеЗаполнено(ИмяСобытияXML) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСобытияРус = СловарьСобытий.Получить(ВРег(ИмяСобытияXML));
	Если ИмяСобытияРус = Неопределено Тогда
		ИмяСобытияРус = ИмяСобытияXML;
	КонецЕсли;
	
	ОбработчикПодписки = ИзвлечьЗначениеТегаXML(ТекстXML, "Handler");
	ОписаниеОбработчика = ?(ЗначениеЗаполнено(ОбработчикПодписки), ИмяПодписки + " (" + ОбработчикПодписки + ")", ИмяПодписки);
	
	ПозSource = СтрНайти(ТекстXML, "<Source>");
	ПозКонSource = СтрНайти(ТекстXML, "</Source>", , Макс(1, ПозSource));
	Если ПозSource = 0 Или ПозКонSource = 0 Тогда
		Возврат;
	КонецЕсли;
	
	БлокSource = Сред(ТекстXML, ПозSource, ПозКонSource - ПозSource);
	ТипыИсточника = ИзвлечьТипыИзБлокаXML(БлокSource);
	Если Не ЗначениеЗаполнено(ТипыИсточника) Тогда
		Возврат;
	КонецЕсли;
	
	МассивТипов = СтрРазделить(ТипыИсточника, ",");
	Для Каждого ЭлементТипа Из МассивТипов Цикл
		СтрТипа = СокрЛП(ЭлементТипа);
		Если СтрНачинаетсяС(СтрТипа, "cfg:") Тогда
			СтрТипа = Сред(СтрТипа, 5);
		КонецЕсли;
		
		ТочкаПоз = СтрНайти(СтрТипа, ".");
		Если ТочкаПоз = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ВидИсточникаАнгл = ВРег(Лев(СтрТипа, ТочкаПоз - 1));
		ИмяОбъектаИсточника = Сред(СтрТипа, ТочкаПоз + 1);
		
		КлассИсточникаРус = "";
		Если ВидИсточникаАнгл = "DOCUMENTOBJECT" Тогда
			КлассИсточникаРус = "Документ";
		ИначеЕсли ВидИсточникаАнгл = "CATALOGOBJECT" Тогда
			КлассИсточникаРус = "Справочник";
		ИначеЕсли ВидИсточникаАнгл = "INFORMATIONREGISTERRECORDSET" Тогда
			КлассИсточникаРус = "РегистрСведений";
		ИначеЕсли ВидИсточникаАнгл = "ACCUMULATIONREGISTERRECORDSET" Тогда
			КлассИсточникаРус = "РегистрНакопления";
		ИначеЕсли ВидИсточникаАнгл = "ACCOUNTINGREGISTERRECORDSET" Тогда
			КлассИсточникаРус = "РегистрБухгалтерии";
		ИначеЕсли ВидИсточникаАнгл = "CALCULATIONREGISTERRECORDSET" Тогда
			КлассИсточникаРус = "РегистрРасчета";
		ИначеЕсли ВидИсточникаАнгл = "EXCHANGEPLANOBJECT" Тогда
			КлассИсточникаРус = "ПланОбмена";
		ИначеЕсли ВидИсточникаАнгл = "CHARTOFCHARACTERISTICTYPESOBJECT" Тогда
			КлассИсточникаРус = "ПланВидовХарактеристик";
		ИначеЕсли ВидИсточникаАнгл = "CHARTOFACCOUNTSOBJECT" Тогда
			КлассИсточникаРус = "ПланСчетов";
		ИначеЕсли ВидИсточникаАнгл = "CHARTOFCALCULATIONTYPESOBJECT" Тогда
			КлассИсточникаРус = "ПланВидовРасчета";
		ИначеЕсли ВидИсточникаАнгл = "BUSINESSPROCESSOBJECT" Тогда
			КлассИсточникаРус = "БизнесПроцесс";
		ИначеЕсли ВидИсточникаАнгл = "TASKOBJECT" Тогда
			КлассИсточникаРус = "Задача";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КлассИсточникаРус) И ЗначениеЗаполнено(ИмяОбъектаИсточника) Тогда
			ЦелевойОбъектПодписки = КлассИсточникаРус + "." + ИмяОбъектаИсточника;
			ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ЦелевойОбъектПодписки, "Событие", ИмяСобытияРус, "ПодпискаНаСобытие", ИмяРасширения, ПорядковыйНомер, Ложь, ОписаниеОбработчика);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИзвлечьАтрибутXML(СтрокаТега, ИмяАтрибута)
	Шаблон = ИмяАтрибута + "=""";
	Поз1 = СтрНайти(СтрокаТега, Шаблон);
	Если Поз1 = 0 Тогда
		Возврат "";
	КонецЕсли;
	НачЗнач = Поз1 + СтрДлина(Шаблон);
	Поз2 = СтрНайти(СтрокаТега, """", , НачЗнач);
	Если Поз2 = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(СтрокаТега, НачЗнач, Поз2 - НачЗнач);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИзвлечьЗначениеТегаXML(ТекстБлока, ИмяТега)
	Откр = "<" + ИмяТега + ">";
	Закр = "</" + ИмяТега + ">";
	Поз1 = СтрНайти(ТекстБлока, Откр);
	Если Поз1 = 0 Тогда
		Возврат "";
	КонецЕсли;
	ДлинаОткр = СтрДлина(Откр);
	Поз2 = СтрНайти(ТекстБлока, Закр, , Поз1 + ДлинаОткр);
	Если Поз2 = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Сред(ТекстБлока, Поз1 + ДлинаОткр, Поз2 - Поз1 - ДлинаОткр));
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИзвлечьТипыИзБлокаXML(ТекстБлока)
	МассивТипов = Новый Массив;
	Поз1 = СтрНайти(ТекстБлока, "<v8:Type>");
	Пока Поз1 > 0 Цикл
		Поз2 = СтрНайти(ТекстБлока, "</v8:Type>", , Поз1 + 9);
		Если Поз2 = 0 Тогда
			Прервать;
		КонецЕсли;
		ИмяТипа = СокрЛП(Сред(ТекстБлока, Поз1 + 9, Поз2 - Поз1 - 9));
		Если ЗначениеЗаполнено(ИмяТипа) Тогда
			МассивТипов.Добавить(ИмяТипа);
		КонецЕсли;
		Поз1 = СтрНайти(ТекстБлока, "<v8:Type>", , Поз2 + 10);
	КонецЦикла;
	Возврат СтрСоединить(МассивТипов, ", ");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СканироватьФайлBSL(ПолноеИмяФайла, ЦелевойОбъектМД, ИмяРасширения, ПорядковыйНомер, СловарьСобытий, МассивЭлементов, ИндексЭлементов)
	
	Попытка
		ЧтениеBSL = Новый ЧтениеТекста(ПолноеИмяФайла, КодировкаТекста.UTF8);
		ТекстBSL = ЧтениеBSL.Прочитать();
		ЧтениеBSL.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
	// Быстрая отсечка: если в модуле вообще нет символа '&', не тратим время на парсинг
	Если Не ЗначениеЗаполнено(ТекстBSL) Или СтрНайти(ТекстBSL, "&") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоМодульФормы = (СтрНайти(ЦелевойОбъектМД, ".Форма.") > 0 Или СтрНачинаетсяС(ЦелевойОбъектМД, "ОбщаяФорма."));
	
	// Поддерживаем русские и английские директивы расширения методов и обработчиков событий
	МассивОписанийДиректив = Новый Массив;
	МассивОписанийДиректив.Добавить(Новый Структура("Искомая, Каноническая", "&Вместо", "&Вместо"));
	МассивОписанийДиректив.Добавить(Новый Структура("Искомая, Каноническая", "&Перед", "&Перед"));
	МассивОписанийДиректив.Добавить(Новый Структура("Искомая, Каноническая", "&После", "&После"));
	МассивОписанийДиректив.Добавить(Новый Структура("Искомая, Каноническая", "&ИзменениеИКонтроль", "&ИзменениеИКонтроль"));
	МассивОписанийДиректив.Добавить(Новый Структура("Искомая, Каноническая", "&Around", "&Вместо"));
	МассивОписанийДиректив.Добавить(Новый Структура("Искомая, Каноническая", "&Before", "&Перед"));
	МассивОписанийДиректив.Добавить(Новый Структура("Искомая, Каноническая", "&After", "&После"));
	МассивОписанийДиректив.Добавить(Новый Структура("Искомая, Каноническая", "&ChangeAndValidate", "&ИзменениеИКонтроль"));
	
	Для Каждого ОписаниеДирективы Из МассивОписанийДиректив Цикл
		ДирективаПоиска = ОписаниеДирективы.Искомая;
		ДирективаКаноническая = ОписаниеДирективы.Каноническая;
		ДлинаДирективы = СтрДлина(ДирективаПоиска);
		
		Позиция = СтрНайти(ТекстBSL, ДирективаПоиска);
		Счетчик = 0;
		Пока Позиция > 0 И Счетчик < 3000 Цикл
			Счетчик = Счетчик + 1;
			
			// Проверяем только 120 символов перед директивой
			НачалоОкна = Макс(1, Позиция - 120);
			ОкноДоДирективы = Сред(ТекстBSL, НачалоОкна, Позиция - НачалоОкна);
			ПозПС = СтрНайти(ОкноДоДирективы, Символы.ПС, НаправлениеПоиска.СКонца);
			Если ПозПС > 0 Тогда
				СтрокаДоДирективы = СокрЛП(Сред(ОкноДоДирективы, ПозПС + 1));
			Иначе
				СтрокаДоДирективы = СокрЛП(ОкноДоДирективы);
			КонецЕсли;
			
			Если СтрНачинаетсяС(СтрокаДоДирективы, "//") Тогда
				// Закомментированная директива, пропускаем
				Позиция = СтрНайти(ТекстBSL, ДирективаПоиска, , Позиция + ДлинаДирективы + 2);
				Продолжить;
			КонецЕсли;
			
			ОстатокТекста = Сред(ТекстBSL, Позиция + ДлинаДирективы, 280);
			
			// Ищем метод или событие в кавычках ("ИмяМетодаИлиСобытия")
			ПозСтр1 = СтрНайти(ОстатокТекста, """");
			Если ПозСтр1 > 0 И ПозСтр1 < 30 Тогда
				ПозСтр2 = СтрНайти(Сред(ОстатокТекста, ПозСтр1 + 1), """");
				Если ПозСтр2 > 0 И ПозСтр2 < 120 Тогда
					ИмяМетода = Сред(ОстатокТекста, ПозСтр1 + 1, ПозСтр2 - 1);
					
					Если СтрДлина(ИмяМетода) > 1 И СтрНайти(ИмяМетода, " ") = 0 И СтрНайти(ИмяМетода, Символы.ПС) = 0 Тогда
						
						// Извлекаем имя собственной процедуры-перехватчика в модуле расширения
						ИмяСобственнойПроцедуры = ИзвлечьИмяПроцедурыПослеДирективы(Сред(ОстатокТекста, ПозСтр1 + ПозСтр2 + 1));
						
						// Проверяем тело конкретной процедуры на вызов ПродолжитьВызов()
						ФрагментТела = ИзвлечьТелоМетода(ТекстBSL, Позиция);
						ЕстьПродолжитьВызов = (СтрНайти(ФрагментТела, "ПродолжитьВызов(") > 0 Или СтрНайти(ФрагментТела, "ProceedWithCall(") > 0);
						
						// Проверяем, является ли перехватываемый метод стандартным обработчиком события
						ВидЭлемента = "Метод";
						КаноническоеИмя = ИмяМетода;
						НайденноеСобытие = СловарьСобытий.Получить(ВРег(ИмяМетода));
						Если НайденноеСобытие <> Неопределено Тогда
							ВидЭлемента = "Событие";
							КаноническоеИмя = НайденноеСобытие;
						ИначеЕсли ЭтоМодульФормы Тогда
							// В модуле формы обработчик события элемента может перехватываться через &Перед/&После("ИмяЭлементаПриИзменении")
							РаспознанноеСобытиеЭлемента = РаспознатьСобытиеЭлементаФормыПоИмениМетода(ИмяМетода);
							Если ЗначениеЗаполнено(РаспознанноеСобытиеЭлемента) Тогда
								ВидЭлемента = "Событие";
								КаноническоеИмя = РаспознанноеСобытиеЭлемента;
							КонецЕсли;
						КонецЕсли;
						
						ЗарегистрироватьЭлементВТаблице(МассивЭлементов, ИндексЭлементов, ЦелевойОбъектМД, ВидЭлемента, КаноническоеИмя, ДирективаКаноническая, ИмяРасширения, ПорядковыйНомер, ЕстьПродолжитьВызов, ИмяСобственнойПроцедуры);
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Позиция = СтрНайти(ТекстBSL, ДирективаПоиска, , Позиция + ДлинаДирективы + 2);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИзвлечьИмяПроцедурыПослеДирективы(ТекстПослеКавычек)
	ТекстВРег = ВРег(ТекстПослеКавычек);
	ДлинаКлючСлова = 10;
	ПозКлюч = СтрНайти(ТекстВРег, "ПРОЦЕДУРА ");
	Если ПозКлюч = 0 Тогда
		ПозКлюч = СтрНайти(ТекстВРег, "ФУНКЦИЯ ");
		ДлинаКлючСлова = 8;
	КонецЕсли;
	Если ПозКлюч = 0 Тогда
		ПозКлюч = СтрНайти(ТекстВРег, "PROCEDURE ");
		ДлинаКлючСлова = 10;
	КонецЕсли;
	Если ПозКлюч = 0 Тогда
		ПозКлюч = СтрНайти(ТекстВРег, "FUNCTION ");
		ДлинаКлючСлова = 9;
	КонецЕсли;
	Если ПозКлюч = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	НачИмени = ПозКлюч + ДлинаКлючСлова;
	ПозСкобки = СтрНайти(ТекстПослеКавычек, "(", , НачИмени);
	Если ПозСкобки = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Сред(ТекстПослеКавычек, НачИмени, ПозСкобки - НачИмени));
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РаспознатьСобытиеЭлементаФормыПоИмениМетода(ИмяМетода)
	МассивСуффиксов = Новый Массив;
	МассивСуффиксов.Добавить("ПриИзменении");
	МассивСуффиксов.Добавить("НачалоВыбора");
	МассивСуффиксов.Добавить("ОбработкаВыбора");
	МассивСуффиксов.Добавить("ПриАктивизацииСтроки");
	МассивСуффиксов.Добавить("ПередНачаломДобавления");
	МассивСуффиксов.Добавить("ПередУдалением");
	МассивСуффиксов.Добавить("ПослеУдаления");
	МассивСуффиксов.Добавить("ПередНачаломИзменения");
	МассивСуффиксов.Добавить("ПриНачалеРедактирования");
	МассивСуффиксов.Добавить("ПриОкончанииРедактирования");
	МассивСуффиксов.Добавить("ПередОкончаниемРедактирования");
	МассивСуффиксов.Добавить("ПриАктивизацииЯчейки");
	МассивСуффиксов.Добавить("ПриАктивизацииПоля");
	МассивСуффиксов.Добавить("ПриСменеСтраницы");
	МассивСуффиксов.Добавить("ОкончаниеВводаТекста");
	МассивСуффиксов.Добавить("АвтоПодбор");
	МассивСуффиксов.Добавить("Нажатие");
	МассивСуффиксов.Добавить("Открытие");
	МассивСуффиксов.Добавить("Очистка");
	МассивСуффиксов.Добавить("ВыборЗначения");
	МассивСуффиксов.Добавить("ВыборСтроки");
	МассивСуффиксов.Добавить("Выбор");
	
	ИмяМетодаВРег = ВРег(ИмяМетода);
	Для Каждого Суффикс Из МассивСуффиксов Цикл
		СуффиксВРег = ВРег(Суффикс);
		Если СтрЗаканчиваетсяНа(ИмяМетодаВРег, СуффиксВРег) И СтрДлина(ИмяМетода) > СтрДлина(Суффикс) Тогда
			ИмяЭлемента = Лев(ИмяМетода, СтрДлина(ИмяМетода) - СтрДлина(Суффикс));
			КанонСуффикс = ?(Суффикс = "ВыборСтроки", "Выбор", Суффикс);
			Возврат ИмяЭлемента + "." + КанонСуффикс;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
КонецФункции

&НаСервере
Процедура ВыявитьКонфликты(ТЗ_Элементы)
	
	// Группируем элементы
	// Для методов и обработчиков событий используем единый канонический ключ без точек и в верхнем регистре
	ГруппыЭлементов = Новый Соответствие;
	
	Для Каждого Стр Из ТЗ_Элементы Цикл
		ЭтоМетодИлиСобытие = (Стр.ВидЭлемента = "Метод" Или Стр.ВидЭлемента = "Событие");
		ВидДляГруппы = ?(ЭтоМетодИлиСобытие, "МЕТОД_СОБЫТИЕ", Стр.ВидЭлемента);
		ИмяДляГруппы = ?(ЭтоМетодИлиСобытие, ВРег(СтрЗаменить(Стр.ИмяЭлемента, ".", "")), ВРег(Стр.ИмяЭлемента));
		
		КлючГруппы = ВРег(Стр.ОбъектМетаданных) + "|" + ВидДляГруппы + "|" + ИмяДляГруппы;
		МассивСтрокГруппы = ГруппыЭлементов.Получить(КлючГруппы);
		Если МассивСтрокГруппы = Неопределено Тогда
			МассивСтрокГруппы = Новый Массив;
			ГруппыЭлементов.Вставить(КлючГруппы, МассивСтрокГруппы);
		КонецЕсли;
		МассивСтрокГруппы.Добавить(Стр);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ГруппыЭлементов Цикл
		СтрокиСовпадений = КлючИЗначение.Значение;
		Если СтрокиСовпадений.Количество() <= 1 Тогда
			Продолжить;
		КонецЕсли;
		
		ПерваяСтрока = СтрокиСовпадений[0];
		ОбъектМетаданныхГруппы = ПерваяСтрока.ОбъектМетаданных;
		ВидЭлементаГруппы = ПерваяСтрока.ВидЭлемента;
		ИмяЭлементаГруппы = ПерваяСтрока.ИмяЭлемента;
		
		// Если хотя бы одна строка в группе распознана как "Событие", вся группа - это Событие
		Для Каждого СтрПров Из СтрокиСовпадений Цикл
			Если СтрПров.ВидЭлемента = "Событие" Тогда
				ВидЭлементаГруппы = "Событие";
				Если СтрНайти(СтрПров.ИмяЭлемента, ".") > 0 Тогда
					ИмяЭлементаГруппы = СтрПров.ИмяЭлемента;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// 1. АНАЛИЗ МЕТОДОВ И ОБРАБОТЧИКОВ СОБЫТИЙ
		Если ВидЭлементаГруппы = "Метод" Или ВидЭлементаГруппы = "Событие" Тогда
			ЭтоСобытие = (ВидЭлементаГруппы = "Событие");
			ПрефиксЭлемента = ?(ЭтоСобытие, "Событие: ", "Метод: ");
			НазваниеСущности = ?(ЭтоСобытие, "Обработчик события", "Метод");
			
			СчетчикВместо = 0;
			СчетчикИзменениеИКонтроль = 0;
			СчетчикПеред = 0;
			СчетчикПосле = 0;
			СчетчикПодписок = 0;
			СписокПерехватов = Новый Массив;
			СписокРасширений = Новый Массив;
			ЕстьБезПродолжитьВызов = Ложь;
			
			Для Каждого СтрМ Из СтрокиСовпадений Цикл
				УточнениеПроцедуры = ?(ЗначениеЗаполнено(СтрМ.ТипДанных), ": " + СтрМ.ТипДанных, "");
				ОписаниеВызова = СтрШаблон("№%1 %2 [%3%4%5]", 
					СтрМ.Порядок, 
					СтрМ.Расширение, 
					СтрМ.ТипПерехвата, 
					УточнениеПроцедуры,
					?(СтрМ.ВызываетПродолжитьВызов, ", с ПродолжитьВызов()", ""));
				СписокПерехватов.Добавить(ОписаниеВызова);
				
				Если СписокРасширений.Найти(СтрМ.Расширение) = Неопределено Тогда
					СписокРасширений.Добавить(СтрМ.Расширение);
				КонецЕсли;
				
				Если СтрНайти(СтрМ.ТипПерехвата, "&Вместо") > 0 Тогда
					СчетчикВместо = СчетчикВместо + 1;
					Если Не СтрМ.ВызываетПродолжитьВызов Тогда
						ЕстьБезПродолжитьВызов = Истина;
					КонецЕсли;
				КонецЕсли;
				Если СтрНайти(СтрМ.ТипПерехвата, "&ИзменениеИКонтроль") > 0 Тогда
					СчетчикИзменениеИКонтроль = СчетчикИзменениеИКонтроль + 1;
				КонецЕсли;
				Если СтрНайти(СтрМ.ТипПерехвата, "&Перед") > 0 Тогда
					СчетчикПеред = СчетчикПеред + 1;
				КонецЕсли;
				Если СтрНайти(СтрМ.ТипПерехвата, "&После") > 0 Тогда
					СчетчикПосле = СчетчикПосле + 1;
				КонецЕсли;
				Если СтрНайти(СтрМ.ТипПерехвата, "ПодпискаНаСобытие") > 0 Тогда
					СчетчикПодписок = СчетчикПодписок + 1;
				КонецЕсли;
			КонецЦикла;
			
			СтрокаРасширений = СтрСоединить(СписокРасширений, ", ");
			ЦепочкаВызовов = СтрСоединить(СписокПерехватов, " -> ");
			
			// А. Критический: Несколько &Вместо или &Вместо без ПродолжитьВызов(), подавляющий другие обработчики
			Если СчетчикВместо > 1 Тогда
				Конфликт = ТаблицаКонфликтов.Добавить();
				Конфликт.Критичность = "Критический";
				Конфликт.ВидКонфликта = ?(ЭтоСобытие, "Множественный &Вместо события", "Множественный &Вместо");
				Конфликт.ОбъектМетаданных = ОбъектМетаданныхГруппы;
				Конфликт.Элемент = ПрефиксЭлемента + ИмяЭлементаГруппы;
				Конфликт.Расширения = СтрокаРасширений;
				
				Если ЕстьБезПродолжитьВызов Тогда
					Конфликт.Описание = СтрШаблон("%1 '%2' перехватывается несколькими &Вместо без вызова ПродолжитьВызов()! Цепочка выполнения: %3. Расширение с более высоким приоритетом полностью подавляет код других расширений.", 
						НазваниеСущности, ИмяЭлементаГруппы, ЦепочкаВызовов);
				Иначе
					Конфликт.Описание = СтрШаблон("%1 '%2' перехватывается несколькими &Вместо. Цепочка выполнения: %3. Порядок выполнения жестко зависит от приоритета расширений в информационной базе.", 
						НазваниеСущности, ИмяЭлементаГруппы, ЦепочкаВызовов);
				КонецЕсли;
				
			ИначеЕсли СчетчикВместо = 1 И ЕстьБезПродолжитьВызов Тогда
				Конфликт = ТаблицаКонфликтов.Добавить();
				Конфликт.Критичность = "Критический";
				Конфликт.ВидКонфликта = "Подавление через &Вместо";
				Конфликт.ОбъектМетаданных = ОбъектМетаданныхГруппы;
				Конфликт.Элемент = ПрефиксЭлемента + ИмяЭлементаГруппы;
				Конфликт.Расширения = СтрокаРасширений;
				Конфликт.Описание = СтрШаблон("%1 '%2' перехватывается директивой &Вместо без вызова ПродолжитьВызов(), из-за чего блокируется выполнение типового кода и связанных обработчиков других расширений: %3.", 
					НазваниеСущности, ИмяЭлементаГруппы, ЦепочкаВызовов);
				
			// Б. Критический: Несколько &ИзменениеИКонтроль (платформа 1С применяет только одно расширение, либо возникает ошибка применения)
			ИначеЕсли СчетчикИзменениеИКонтроль > 1 Тогда
				Конфликт = ТаблицаКонфликтов.Добавить();
				Конфликт.Критичность = "Критический";
				Конфликт.ВидКонфликта = "Множественный &ИзменениеИКонтроль";
				Конфликт.ОбъектМетаданных = ОбъектМетаданныхГруппы;
				Конфликт.Элемент = ПрефиксЭлемента + ИмяЭлементаГруппы;
				Конфликт.Расширения = СтрокаРасширений;
				Конфликт.Описание = СтрШаблон("%1 '%2' модифицируется директивой &ИзменениеИКонтроль одновременно в нескольких расширениях: %3. Платформа 1С не может объединить несколько &ИзменениеИКонтроль одного метода (применяется только расширение с наивысшим приоритетом либо возникает ошибка применимости).", 
					НазваниеСущности, ИмяЭлементаГруппы, СтрокаРасширений);
				
			// В. Обработчики событий в нескольких расширениях (как Перед, так и После / Подписки на события)
			ИначеЕсли ЭтоСобытие Тогда
				Конфликт = ТаблицаКонфликтов.Добавить();
				Если СчетчикПеред > 1 Или СчетчикПосле > 1 Тогда
					Конфликт.Критичность = "Предупреждение";
					Конфликт.ВидКонфликта = "Пересечение обработчиков события (Перед/После)";
				Иначе
					Конфликт.Критичность = "Информация";
					Конфликт.ВидКонфликта = "Общий обработчик события (Перед и После)";
				КонецЕсли;
				Конфликт.ОбъектМетаданных = ОбъектМетаданныхГруппы;
				Конфликт.Элемент = ПрефиксЭлемента + ИмяЭлементаГруппы;
				Конфликт.Расширения = СтрокаРасширений;
				Конфликт.Описание = СтрШаблон("Обработчик события '%1' расширен сразу в нескольких расширениях (Перед: %2, После: %3%4). Участники: %5. Проверьте взаимное влияние на параметры события (Отказ, СтандартнаяОбработка, Объект, Элементы).", 
					ИмяЭлементаГруппы, Строка(СчетчикПеред), Строка(СчетчикПосле), ?(СчетчикПодписок > 0, ", Подписок: " + Строка(СчетчикПодписок), ""), ЦепочкаВызовов);
				
			// Г. Множественные &Перед / &После обычных методов
			Иначе
				Конфликт = ТаблицаКонфликтов.Добавить();
				Конфликт.Критичность = ?(СчетчикПеред > 1 Или СчетчикПосле > 1, "Предупреждение", "Информация");
				Конфликт.ВидКонфликта = "Общий перехватчик метода";
				Конфликт.ОбъектМетаданных = ОбъектМетаданныхГруппы;
				Конфликт.Элемент = ПрефиксЭлемента + ИмяЭлементаГруппы;
				Конфликт.Расширения = СтрокаРасширений;
				Конфликт.Описание = СтрШаблон("Метод '%1' перехватывается несколькими расширениями (Перед: %2, После: %3) в очередности: %4. Убедитесь, что логика расширений не конфликтует по параметрам и контексту.", 
					ИмяЭлементаГруппы, Строка(СчетчикПеред), Строка(СчетчикПосле), ЦепочкаВызовов);
			КонецЕсли;
			
		// 2. АНАЛИЗ МЕТАДАННЫХ (Объекты, Реквизиты, Табличные части, Формы)
		Иначе
			КоличествоНовыхСозданных = 0;
			СписокТиповДанных = Новый Массив;
			СписокРасширений = Новый Массив;
			
			Для Каждого СтрС Из СтрокиСовпадений Цикл
				Если СписокРасширений.Найти(СтрС.Расширение) = Неопределено Тогда
					СписокРасширений.Добавить(СтрС.Расширение + " (№" + СтрС.Порядок + ")");
				КонецЕсли;
				
				Если СтрС.ТипПерехвата = "Создан в расширении" Или СтрС.ТипПерехвата = "Добавлен реквизит" Или СтрС.ТипПерехвата = "Добавлена ТЧ" Или СтрС.ТипПерехвата = "Форма" Тогда
					КоличествоНовыхСозданных = КоличествоНовыхСозданных + 1;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрС.ТипДанных) И СписокТиповДанных.Найти(СтрС.ТипДанных) = Неопределено Тогда
					СписокТиповДанных.Добавить(СтрС.ТипДанных);
				КонецЕсли;
			КонецЦикла;
			
			СтрокаРасширений = СтрСоединить(СписокРасширений, ", ");
			
			// А. Реальный конфликт 1: Два расширения создали новый объект/реквизит/ТЧ/форму с одинаковым именем
			Если КоличествоНовыхСозданных > 1 Тогда
				Конфликт = ТаблицаКонфликтов.Добавить();
				Конфликт.Критичность = "Критический";
				Конфликт.ВидКонфликта = "Дублирование нового элемента";
				Конфликт.ОбъектМетаданных = ОбъектМетаданныхГруппы;
				Конфликт.Элемент = ВидЭлементаГруппы + ": " + ИмяЭлементаГруппы;
				Конфликт.Расширения = СтрокаРасширений;
				Конфликт.Описание = СтрШаблон("Элемент '%1' добавлен как новый сразу в нескольких расширениях (%2)! Произойдет коллизия пространства имен метаданных.", 
					ИмяЭлементаГруппы, СтрокаРасширений);
					
			// Б. Реальный конфликт 2: Несовпадение типов данных у добавленных/заимствованных реквизитов
			ИначеЕсли СписокТиповДанных.Количество() > 1 Тогда
				Конфликт = ТаблицаКонфликтов.Добавить();
				Конфликт.Критичность = "Критический";
				Конфликт.ВидКонфликта = "Несовместимость типов данных";
				Конфликт.ОбъектМетаданных = ОбъектМетаданныхГруппы;
				Конфликт.Элемент = ВидЭлементаГруппы + ": " + ИмяЭлементаГруппы;
				Конфликт.Расширения = СтрокаРасширений;
				Конфликт.Описание = СтрШаблон("Реквизит '%1' имеет несовпадающие типы в расширениях: %2. Одно расширение ожидает один тип данных, другое - иной.", 
					ИмяЭлементаГруппы, СтрСоединить(СписокТиповДанных, " vs "));
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоОбъектов(ТЗ_Элементы, ДеревоОбъектовДанные)
	
	// 1. Строим индекс конфликтов по каноническому ключу ОбъектМетаданных + "|" + ИмяБезТочек
	ИндексКонфликтов = Новый Соответствие;
	Для Каждого СтрК Из ТаблицаКонфликтов Цикл
		ИндексКонфликтов.Вставить(ВРег(СтрК.ОбъектМетаданных + "|" + СтрК.Элемент), Истина);
		ПозДвоеточия = СтрНайти(СтрК.Элемент, ": ");
		Если ПозДвоеточия > 0 Тогда
			ЧистоеИмя = Сред(СтрК.Элемент, ПозДвоеточия + 2);
			ИндексКонфликтов.Вставить(ВРег(СтрК.ОбъектМетаданных + "|" + СтрЗаменить(ЧистоеИмя, ".", "")), Истина);
		КонецЕсли;
	КонецЦикла;
	
	// 2. Группируем ТЗ_Элементы в иерархию Объект -> Элемент -> МассивСтрокРасширений
	КартаОбъектов = Новый Соответствие;
	СписокИменОбъектов = Новый СписокЗначений;
	
	Для Каждого Стр Из ТЗ_Элементы Цикл
		ИмяОбъектаМД = Стр.ОбъектМетаданных;
		КартаЭлементовОбъекта = КартаОбъектов.Получить(ИмяОбъектаМД);
		Если КартаЭлементовОбъекта = Неопределено Тогда
			КартаЭлементовОбъекта = Новый Соответствие;
			КартаОбъектов.Вставить(ИмяОбъектаМД, КартаЭлементовОбъекта);
			СписокИменОбъектов.Добавить(ИмяОбъектаМД);
		КонецЕсли;
		
		ЭтоМетодИлиСобытие = (Стр.ВидЭлемента = "Метод" Или Стр.ВидЭлемента = "Событие");
		КлючЭлементаВКарте = ?(ЭтоМетодИлиСобытие, "М_С|" + ВРег(СтрЗаменить(Стр.ИмяЭлемента, ".", "")), Стр.ВидЭлемента + "|" + ВРег(Стр.ИмяЭлемента));
		
		ОписаниеЭлемента = КартаЭлементовОбъекта.Получить(КлючЭлементаВКарте);
		Если ОписаниеЭлемента = Неопределено Тогда
			ОписаниеЭлемента = Новый Структура("ИмяЭлемента, ВидЭлемента, СтрокиРасширений", Стр.ИмяЭлемента, Стр.ВидЭлемента, Новый Массив);
			КартаЭлементовОбъекта.Вставить(КлючЭлементаВКарте, ОписаниеЭлемента);
		ИначеЕсли Стр.ВидЭлемента = "Событие" Тогда
			ОписаниеЭлемента.ВидЭлемента = "Событие";
			Если СтрНайти(Стр.ИмяЭлемента, ".") > 0 Тогда
				ОписаниеЭлемента.ИмяЭлемента = Стр.ИмяЭлемента;
			КонецЕсли;
		КонецЕсли;
		ОписаниеЭлемента.СтрокиРасширений.Добавить(Стр);
	КонецЦикла;
	
	СписокИменОбъектов.СортироватьПоЗначению();
	
	// 3. Строим дерево без единого вызова НайтиСтроки()
	Для Каждого ЭлементСпискаОбъектов Из СписокИменОбъектов Цикл
		ИмяОбъектаМД = ЭлементСпискаОбъектов.Значение;
		КартаЭлементовОбъекта = КартаОбъектов.Получить(ИмяОбъектаМД);
		
		СтрокаДереваОбъект = ДеревоОбъектовДанные.Строки.Добавить();
		СтрокаДереваОбъект.Наименование = ИмяОбъектаМД;
		СтрокаДереваОбъект.Вид = "Объект";
		СтрокаДереваОбъект.ЕстьКонфликт = "Нет";
		
		Для Каждого КлючИЗначение Из КартаЭлементовОбъекта Цикл
			ОписаниеЭлемента = КлючИЗначение.Значение;
			ИмяЭлемента = ОписаниеЭлемента.ИмяЭлемента;
			ВидЭлемента = ОписаниеЭлемента.ВидЭлемента;
			
			СтрокаДереваЭлемент = СтрокаДереваОбъект.Строки.Добавить();
			СтрокаДереваЭлемент.Наименование = ИмяЭлемента;
			СтрокаДереваЭлемент.Вид = ВидЭлемента;
			
			КлючКонфликта1 = ВРег(ИмяОбъектаМД + "|" + ВидЭлемента + ": " + ИмяЭлемента);
			КлючКонфликта2 = ВРег(ИмяОбъектаМД + "|" + СтрЗаменить(ИмяЭлемента, ".", ""));
			
			Если ИндексКонфликтов.Получить(КлючКонфликта1) = Истина Или ИндексКонфликтов.Получить(КлючКонфликта2) = Истина Тогда
				СтрокаДереваЭлемент.ЕстьКонфликт = "Да";
				СтрокаДереваОбъект.ЕстьКонфликт = "Да";
			Иначе
				СтрокаДереваЭлемент.ЕстьКонфликт = "Нет";
			КонецЕсли;
			
			Для Каждого СтрР Из ОписаниеЭлемента.СтрокиРасширений Цикл
				СтрокаДереваРасш = СтрокаДереваЭлемент.Строки.Добавить();
				СтрокаДереваРасш.Наименование = "№" + СтрР.Порядок + " " + СтрР.Расширение;
				СтрокаДереваРасш.Вид = "Расширение";
				СтрокаДереваРасш.ТипПерехвата = СтрР.ТипПерехвата + ?(СтрР.ВызываетПродолжитьВызов, " (с ПродолжитьВызов)", "") + ?(ЗначениеЗаполнено(СтрР.ТипДанных), " [" + СтрР.ТипДанных + "]", "");
				СтрокаДереваРасш.Расширение = СтрР.Расширение;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформлениеФормы()
	
	// 1. Критические конфликты (Красный цвет, полужирный шрифт)
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина));
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("КонфликтКритичность");
	
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКонфликтов.Критичность");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "Критический";
	Отбор.Использование = Истина;
	
	// 2. Предупреждения (Оранжевый цвет)
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ТемноОранжевый);
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("КонфликтКритичность");
	
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКонфликтов.Критичность");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "Предупреждение";
	Отбор.Использование = Истина;
	
	// 3. Информация (Синий цвет)
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Синий);
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("КонфликтКритичность");
	
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаКонфликтов.Критичность");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "Информация";
	Отбор.Использование = Истина;
	
	// 4. Дерево объектов - конфликтные строки (Красный цвет, полужирный шрифт)
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина));
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ДеревоЕстьКонфликт");
	
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоОбъектов.ЕстьКонфликт");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "Да";
	Отбор.Использование = Истина;
	
КонецПроцедуры

&НаСервере
Функция СформироватьТабличныйДокументНаСервере()
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Истина;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.Защита = Ложь;
	
	ШрифтЗаголовок = Новый Шрифт(, 14, Истина);
	ШрифтПодзаголовок = Новый Шрифт(, 10, Истина);
	ШрифтШапка = Новый Шрифт(, 9, Истина);
	ШрифтОбычный = Новый Шрифт(, 9, Ложь);
	ШрифтЖирный = Новый Шрифт(, 9, Истина);
	
	ЦветФонаШапка = Новый Цвет(230, 235, 245);
	ЦветФонаКритический = Новый Цвет(255, 220, 220);
	ЦветФонаПредупреждение = Новый Цвет(255, 245, 220);
	ЦветФонаИнформация = Новый Цвет(225, 240, 255);
	
	ЛинияТонкая = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	
	// Шапка отчета
	НомерСтроки = 1;
	Область = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 7);
	Область.Объединить();
	Область.Шрифт = ШрифтЗаголовок;
	Область.Текст = "ОТЧЕТ ПО АНАЛИЗУ РАСШИРЕНИЙ КОНФИГУРАЦИИ";
	
	НомерСтроки = НомерСтроки + 1;
	Область = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 7);
	Область.Объединить();
	Область.Шрифт = ШрифтПодзаголовок;
	Область.Текст = "Сформирован: " + Формат(ТекущаяДата(), "ДЛФ=DT") 
		+ " | Всего расширений: " + Строка(ВсегоРасширений) 
		+ " | Обнаружено конфликтов: " + Строка(ВсегоКонфликтов);
	
	НомерСтроки = НомерСтроки + 2;
	
	// Раздел 1. Таблица конфликтов
	Область = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 7);
	Область.Объединить();
	Область.Шрифт = ШрифтПодзаголовок;
	Область.Текст = "1. ВЫЯВЛЕННЫЕ КОНФЛИКТЫ И КОЛЛИЗИИ";
	
	НомерСтроки = НомерСтроки + 1;
	ШапкаКолонки = Новый Массив;
	ШапкаКолонки.Добавить("№");
	ШапкаКолонки.Добавить("Критичность");
	ШапкаКолонки.Добавить("Вид конфликта");
	ШапкаКолонки.Добавить("Объект метаданных");
	ШапкаКолонки.Добавить("Метод / Реквизит");
	ШапкаКолонки.Добавить("Участвующие расширения");
	ШапкаКолонки.Добавить("Описание и рекомендация");
	
	Для Кол = 1 По ШапкаКолонки.Количество() Цикл
		Ячейка = ТабДок.Область(НомерСтроки, Кол);
		Ячейка.Текст = ШапкаКолонки[Кол - 1];
		Ячейка.Шрифт = ШрифтШапка;
		Ячейка.ЦветФона = ЦветФонаШапка;
		Ячейка.Обвести(ЛинияТонкая, ЛинияТонкая, ЛинияТонкая, ЛинияТонкая);
	КонецЦикла;
	
	Если ТаблицаКонфликтов.Количество() = 0 Тогда
		НомерСтроки = НомерСтроки + 1;
		Область = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 7);
		Область.Объединить();
		Область.Текст = "Конфликтов и коллизий не обнаружено. Все проверенные расширения совместимы.";
		Область.Шрифт = ШрифтОбычный;
		Область.ЦветТекста = WebЦвета.Зеленый;
		Область.Обвести(ЛинияТонкая, ЛинияТонкая, ЛинияТонкая, ЛинияТонкая);
	Иначе
		Нпп = 0;
		Для Каждого СтрК Из ТаблицаКонфликтов Цикл
			Нпп = Нпп + 1;
			НомерСтроки = НомерСтроки + 1;
			
			ЦветСтроки = Неопределено;
			Если СтрК.Критичность = "Критический" Тогда
				ЦветСтроки = ЦветФонаКритический;
			ИначеЕсли СтрК.Критичность = "Предупреждение" Тогда
				ЦветСтроки = ЦветФонаПредупреждение;
			Иначе
				ЦветСтроки = ЦветФонаИнформация;
			КонецЕсли;
			
			ТабДок.Область(НомерСтроки, 1).Текст = Строка(Нпп);
			ТабДок.Область(НомерСтроки, 2).Текст = СтрК.Критичность;
			ТабДок.Область(НомерСтроки, 3).Текст = СтрК.ВидКонфликта;
			ТабДок.Область(НомерСтроки, 4).Текст = СтрК.ОбъектМетаданных;
			ТабДок.Область(НомерСтроки, 5).Текст = СтрК.Элемент;
			ТабДок.Область(НомерСтроки, 6).Текст = СтрК.Расширения;
			ТабДок.Область(НомерСтроки, 7).Текст = СтрК.Описание;
			
			Для Кол = 1 По 7 Цикл
				Ячейка = ТабДок.Область(НомерСтроки, Кол);
				Ячейка.Шрифт = ?(Кол = 2 И СтрК.Критичность = "Критический", ШрифтЖирный, ШрифтОбычный);
				Если Кол = 2 Тогда
					Ячейка.ЦветФона = ЦветСтроки;
				КонецЕсли;
				Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
				Ячейка.АвтоВысотаСтроки = Истина;
				Ячейка.Обвести(ЛинияТонкая, ЛинияТонкая, ЛинияТонкая, ЛинияТонкая);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	НомерСтроки = НомерСтроки + 2;
	
	// Раздел 2. Список расширений
	Область = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 7);
	Область.Объединить();
	Область.Шрифт = ШрифтПодзаголовок;
	Область.Текст = "2. СПИСОК РАСШИРЕНИЙ В ИНФОРМАЦИОННОЙ БАЗЕ";
	
	НомерСтроки = НомерСтроки + 1;
	ШапкаРасш = Новый Массив;
	ШапкаРасш.Добавить("№");
	ШапкаРасш.Добавить("Имя расширения");
	ШапкаРасш.Добавить("Синоним");
	ШапкаРасш.Добавить("Версия");
	ШапкаРасш.Добавить("Активно");
	ШапкаРасш.Добавить("Безопасный режим");
	ШапкаРасш.Добавить("Назначение");
	
	Для Кол = 1 По ШапкаРасш.Количество() Цикл
		Ячейка = ТабДок.Область(НомерСтроки, Кол);
		Ячейка.Текст = ШапкаРасш[Кол - 1];
		Ячейка.Шрифт = ШрифтШапка;
		Ячейка.ЦветФона = ЦветФонаШапка;
		Ячейка.Обвести(ЛинияТонкая, ЛинияТонкая, ЛинияТонкая, ЛинияТонкая);
	КонецЦикла;
	
	Для Каждого СтрР Из ТаблицаРасширений Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ТабДок.Область(НомерСтроки, 1).Текст = Строка(СтрР.Порядок);
		ТабДок.Область(НомерСтроки, 2).Текст = СтрР.Имя;
		ТабДок.Область(НомерСтроки, 3).Текст = СтрР.Синоним;
		ТабДок.Область(НомерСтроки, 4).Текст = СтрР.Версия;
		ТабДок.Область(НомерСтроки, 5).Текст = ?(СтрР.Активно, "Да", "Нет");
		ТабДок.Область(НомерСтроки, 6).Текст = ?(СтрР.БезопасныйРежим, "Да", "Нет");
		ТабДок.Область(НомерСтроки, 7).Текст = СтрР.Назначение;
		
		Для Кол = 1 По 7 Цикл
			Ячейка = ТабДок.Область(НомерСтроки, Кол);
			Ячейка.Шрифт = ШрифтОбычный;
			Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Ячейка.АвтоВысотаСтроки = Истина;
			Ячейка.Обвести(ЛинияТонкая, ЛинияТонкая, ЛинияТонкая, ЛинияТонкая);
		КонецЦикла;
	КонецЦикла;
	
	// Настройка ширины колонок
	ТабДок.Область(, 1, , 1).ШиринаКолонки = 5;
	ТабДок.Область(, 2, , 2).ШиринаКолонки = 18;
	ТабДок.Область(, 3, , 3).ШиринаКолонки = 25;
	ТабДок.Область(, 4, , 4).ШиринаКолонки = 25;
	ТабДок.Область(, 5, , 5).ШиринаКолонки = 25;
	ТабДок.Область(, 6, , 6).ШиринаКолонки = 25;
	ТабДок.Область(, 7, , 7).ШиринаКолонки = 50;
	
	Возврат ТабДок;
	
КонецФункции

#КонецОбласти
